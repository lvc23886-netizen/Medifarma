FORM lleba_bapi_cent_nofav USING pu_werks_f
                                     pu_atp1010
                                     pu_atp1020
                                     pu_atp1091
                                     pu_fecha2
                                     pu_meins
                                     pu_necp1010
                                     pu_necp1020
                                     pu_necp1091.
  CASE pu_werks_f.
    WHEN '1010'.

      gl_atp1020 = pu_atp1020 - pu_necp1020.
      IF gl_atp1020 GT 0.
        i_requirements_schedule_in2-req_qty   = gl_atp1020.
        req_data2-req_qty = pu_atp1020.
      ELSE.
        i_requirements_schedule_in2-req_qty   = 0.
        req_data2-req_qty = 0.
      ENDIF.
      i_requirements_schedule_in2-date_type = '1'.
      i_requirements_schedule_in2-req_date  = pu_fecha2.
*        i_requirements_schedule_in2-req_qty   = pu_atp1020.
      i_requirements_schedule_in2-unit      = pu_meins.
      APPEND i_requirements_schedule_in2.
      req_data2-date_type = 1.
      req_data2-req_date = pu_fecha2.
      req_data2-req_qty = pu_atp1020.
      APPEND req_data2.

      gl_atp1091 = pu_atp1091 - pu_necp1091.
      IF gl_atp1091 GT 0.
        i_requirements_schedule_in3-req_qty   = gl_atp1091.
        req_data3-req_qty = pu_atp1091.
      ELSE.
        i_requirements_schedule_in3-req_qty   = 0.
        req_data3-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in3-date_type = '1'.
      i_requirements_schedule_in3-req_date  = pu_fecha2.
*      i_requirements_schedule_in3-req_qty   = pu_atp1091.
      i_requirements_schedule_in3-unit      = pu_meins.
      APPEND i_requirements_schedule_in3.
      req_data3-date_type = 1.
      req_data3-req_date = pu_fecha2.
*      req_data3-req_qty = pu_atp1091.
      APPEND req_data3.


    WHEN '1020'.

      gl_atp1010 = pu_atp1010 - pu_necp1010.
      IF gl_atp1010 GT 0.
        i_requirements_schedule_in2-req_qty   = gl_atp1010.
        req_data2-req_qty = pu_atp1010.
      ELSE.
        i_requirements_schedule_in2-req_qty   = 0.
        req_data2-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in2-date_type = '1'.
      i_requirements_schedule_in2-req_date  = pu_fecha2.
*      i_requirements_schedule_in2-req_qty   = pu_atp1010.
      i_requirements_schedule_in2-unit      = pu_meins.
      APPEND i_requirements_schedule_in2.
      req_data2-date_type = 1.
      req_data2-req_date = pu_fecha2.
*      req_data2-req_qty = pu_atp1010.
      APPEND req_data2.

      gl_atp1091 = pu_atp1091 - pu_necp1091.
      IF gl_atp1091 GT 0.
        i_requirements_schedule_in3-req_qty   = gl_atp1091.
        req_data3-req_qty = pu_atp1091.
      ELSE.
        i_requirements_schedule_in3-req_qty   = 0.
        req_data3-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in3-date_type = '1'.
      i_requirements_schedule_in3-req_date  = pu_fecha2.
*    i_requirements_schedule_in3-req_qty   = pu_atp1091.
      i_requirements_schedule_in3-unit      = pu_meins.
      APPEND i_requirements_schedule_in3.
      req_data3-date_type = 1.
      req_data3-req_date = pu_fecha2.
*    req_data3-req_qty = pu_atp1091.
      APPEND req_data3.

    WHEN '1091'.

      gl_atp1010 = pu_atp1010 - pu_necp1010.
      IF gl_atp1010 GT 0.
        i_requirements_schedule_in2-req_qty   = gl_atp1010.
        req_data2-req_qty = pu_atp1010.
      ELSE.
        i_requirements_schedule_in2-req_qty   = 0.
        req_data2-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in2-date_type = '1'.
      i_requirements_schedule_in2-req_date  = pu_fecha2.
*      i_requirements_schedule_in2-req_qty   = pu_atp1010.
      i_requirements_schedule_in2-unit      = pu_meins.
      APPEND i_requirements_schedule_in2.
      req_data2-date_type = 1.
      req_data2-req_date = pu_fecha2.
*      req_data2-req_qty = pu_atp1010.
      APPEND req_data2.

      gl_atp1020 = pu_atp1020 - pu_necp1020.
      IF gl_atp1020 GT 0.
        i_requirements_schedule_in3-req_qty   = gl_atp1020.
        req_data3-req_qty = pu_atp1020.
      ELSE.
        i_requirements_schedule_in3-req_qty   = 0.
        req_data3-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in3-date_type = '1'.
      i_requirements_schedule_in3-req_date  = pu_fecha2.
*      i_requirements_schedule_in3-req_qty   = pu_atp1020.
      i_requirements_schedule_in3-unit      = pu_meins.
      APPEND i_requirements_schedule_in3.
      req_data3-date_type = 1.
      req_data3-req_date = pu_fecha2.
*      req_data3-req_qty = pu_atp1020.
      APPEND req_data3.

  ENDCASE.
ENDFORM. " LLEBA_BAPI_CENT_NOFAV
*&---------------------------------------------------------------------*
*&      Form  MODIFICA_NECESIDAD1
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_ST_ALV1_2_MATNR  text
*      -->P_GL_WERKS  text
*      -->P_TI_BAPISSHDIN  text
*----------------------------------------------------------------------*
FORM modifica_necesidad1 USING pu_matnr
                                   pu_werks
                                   p_req_data TYPE tty_bapisshdin.

  DATA: gwa_requirement_param1         LIKE cm60r.
  CLEAR: gwa_requirement_param1.
  gwa_requirement_param1-status = 'X'.
  gwa_requirement_param1-trtyp = 'X'.
  gwa_requirement_param1-syncron = 'X'.
  CALL FUNCTION 'BAPI_REQUIREMENTS_CHANGE'
        EXPORTING
          material                       = pu_matnr
          plant                          = pu_werks
          requirementstype               = 'VSF'
          version                        = '00'
          reqmtsplannumber               = st_pbim-pbdnr
          vers_activ                     = 'X'
          requirement_param              = gwa_requirement_param1
*   MRP_AREA                       =
         do_commit                      = ' '
         update_mode                    = 'X'
         delete_old                     = 'X'
*   NO_WITHDR                      = ' '
*   MATERIAL_EVG                   =
* IMPORTING
*   REQUIREMENT_ITEM_OUT           =
        TABLES
         requirements_schedule_in       = p_req_data[]
*   REQUIREMENTS_CHAR_IN           =
          return                         = return[].
*  IF return[] IS INITIAL.
*    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
*      EXPORTING
*        wait = 'X'.
*    CLEAR:st_log.
*    st_log-matnr = pu_matnr.
*    st_log-werks = pu_werks.
*    st_log-msgv1 = 'Se generó las necesidades correctamente'.
*    st_log-id = c_i.
*    MOVE: 'I' TO st_log-msgtyp.
*              return-number  TO st_log-msgnr,
*              return-id  TO st_log-msgid.
*    APPEND st_log TO ti_log.
*  ELSE.
*    LOOP AT return.
*      CLEAR:st_log.
*      st_log-matnr = pu_matnr.
*      st_log-werks = pu_werks.
*      st_log-msgv1 = return-message.
*      st_log-id = c_e.
*      MOVE: return-type TO st_log-msgtyp,
*              return-number  TO st_log-msgnr,
*              return-id  TO st_log-msgid.
*      APPEND st_log TO ti_log.
*    ENDLOOP.
*  ENDIF.
ENDFORM. " MODIFICA_NECESIDAD1
*&---------------------------------------------------------------------*
*&      Form  CREA_NECESIDAD1
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_ST_ALV1_2_MATNR  text
*      -->P_GL_WERKS  text
*      -->P_I_REQUIREMENTS_SCHEDULE_IN2[]  text
*----------------------------------------------------------------------*
FORM crea_necesidad1 USING pu_matnr
                               pu_werks
                               p_i_requirements_schedule_in TYPE tty_bapisshdin.

  CLEAR w_bapisitemr.
  w_bapisitemr-material   = pu_matnr.
  w_bapisitemr-plant      = pu_werks.
  w_bapisitemr-requ_type  = 'VSF'.
  w_bapisitemr-version    = '00'.
  w_bapisitemr-vers_activ = 'X'.
*  w_bapisitemr-req_number = c_reqmtsplannumber.


  CALL FUNCTION 'BAPI_REQUIREMENTS_CREATE'
    EXPORTING
      requirements_item        = w_bapisitemr
    TABLES
      requirements_schedule_in = p_i_requirements_schedule_in
      return                   = i_bapireturn1.


ENDFORM. " CREA_NECESIDAD1
