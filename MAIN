*      -->P_ST_ALV1_2_NEC_P2010  text
*      -->P_ST_ALV1_2_NEC_P2020  text
*----------------------------------------------------------------------*
FORM lleba_bapi_cent_nofav2000 USING pu_werks_f
                                     pu_atp2010
                                     pu_atp2020
*                                     pu_atp1091
                                     pu_fecha2
                                     pu_meins
                                     pu_necp2010
                                     pu_necp2020.
*                                     pu_necp1091.
  CASE pu_werks_f.
    WHEN '2010'.

      gl_atp2020 = pu_atp2020 - pu_necp2020.
      IF gl_atp2020 GT 0.
        i_requirements_schedule_in2-req_qty   = pu_atp2020.
        req_data2-req_qty = pu_atp2020.
      ELSE.
        i_requirements_schedule_in2-req_qty   = 0.
        req_data2-req_qty = 0.
      ENDIF.
      i_requirements_schedule_in2-date_type = '1'.
      i_requirements_schedule_in2-req_date  = pu_fecha2.
*        i_requirements_schedule_in2-req_qty   = pu_atp1020.
      i_requirements_schedule_in2-unit      = pu_meins.
      APPEND i_requirements_schedule_in2.
      req_data2-date_type = 1.
      req_data2-req_date = pu_fecha2.
      req_data2-req_qty = pu_atp2020.
      APPEND req_data2.
    WHEN '2020'.

      gl_atp2010 = pu_atp2010 - pu_necp2010.
      IF gl_atp1010 GT 0.
        i_requirements_schedule_in2-req_qty   = pu_atp2010.
        req_data2-req_qty = pu_atp2010.
      ELSE.
        i_requirements_schedule_in2-req_qty   = 0.
        req_data2-req_qty   = 0.
      ENDIF.
      i_requirements_schedule_in2-date_type = '1'.
      i_requirements_schedule_in2-req_date  = pu_fecha2.
*      i_requirements_schedule_in2-req_qty   = pu_atp1010.
      i_requirements_schedule_in2-unit      = pu_meins.
      APPEND i_requirements_schedule_in2.
      req_data2-date_type = 1.
      req_data2-req_date = pu_fecha2.
*      req_data2-req_qty = pu_atp2010.
      APPEND req_data2.

  ENDCASE.

ENDFORM. " LLEBA_BAPI_CENT_NOFAV2000
