DATA: lt_exclude TYPE ui_functions,
      lw_layout  TYPE lvc_s_layo,
      lw_varian  TYPE disvariant.

RANGES: r_spmon FOR s700-spmon,
        r_spmon_m1 FOR s700-spmon, "MES ACTUAL
        r_fecha1 FOR sy-datum,
        r_fecha FOR sy-datum.
DATA: gl_mensaje TYPE string,
           gl_ans     TYPE c,
           gl_tabix TYPE sy-tabix.
DATA: st_char TYPE ty_char,
            ti_char LIKE STANDARD TABLE OF st_char.
DATA: s_caract_char TYPE bapi1003_alloc_values_char,
      s_caract_num  TYPE  bapi1003_alloc_values_num,
      s_caract_curr TYPE  bapi1003_alloc_values_curr.
DATA: BEGIN OF i_requirements_schedule_in OCCURS 0.
        INCLUDE STRUCTURE bapisshdin.
