        INCLUDE STRUCTURE bapisshdin.
DATA: END OF i_requirements_schedule_in2.
DATA: BEGIN OF i_requirements_schedule_in3 OCCURS 0.
        INCLUDE STRUCTURE bapisshdin.
DATA: END OF i_requirements_schedule_in3.
DATA: i_bapireturn1 LIKE bapireturn1 OCCURS 0,
      w_bapireturn1 LIKE bapireturn1.
DATA: i_caract_char LIKE STANDARD TABLE OF s_caract_char,
      i_caract_num  LIKE STANDARD TABLE OF  s_caract_num,
      i_caract_curr LIKE STANDARD TABLE OF  s_caract_curr.
DATA: req_data LIKE bapisshdin OCCURS 0 WITH HEADER LINE,
      req_data2 LIKE bapisshdin OCCURS 0 WITH HEADER LINE,
      req_data3 LIKE bapisshdin OCCURS 0 WITH HEADER LINE.
DATA: return LIKE bapireturn1 OCCURS 0 WITH HEADER LINE.
DATA: w_bapisitemr LIKE bapisitemr.
DATA: gl_werks TYPE marc-werks. "LV
FIELD-SYMBOLS: <fs_alv> TYPE ty_alv1.
CONSTANTS: c_i TYPE icon-id VALUE '@08@', " Success
           c_w TYPE icon-id VALUE '@09@', " Warning
           c_e TYPE icon-id VALUE '@0A@'. " Error
RANGES: r_werks FOR t001w-werks.
DATA: gl_atp1010 TYPE mard-labst,
      gl_atp1020 TYPE mard-labst,
      gl_atp2010 TYPE mard-labst,
      gl_atp2020 TYPE mard-labst,
      gl_atp1091 TYPE mard-labst.

*----------------------------------------------------------------------*
*        PARÁMETROS DE SELECCIÓN                                       *
*----------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE text-b01.
PARAMETERS: p_bukrs TYPE t001-bukrs OBLIGATORY DEFAULT '1000'.
SELECT-OPTIONS:
    s_forma   FOR  s700e-prgrp,       "Modelo(grupo de productos)
    s_matnr    FOR  mara-matnr,       "Número de material
    s_dispo    FOR marc-dispo.
PARAMETERS: p_re TYPE t158-prreg OBLIGATORY DEFAULT 'PP'.
SELECTION-SCREEN END OF BLOCK b01.

START-OF-SELECTION.
  PERFORM selecciona_datos.
  PERFORM procesa_datos.
  PERFORM muestra_datos.
*&---------------------------------------------------------------------*
*&      Form  SELECCIONA_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM selecciona_datos .
  DATA: l_perio TYPE numc2,
          l_anio  TYPE numc4,
          l_datum TYPE sy-datum.
*  CLEAR:s_opt.
*  s_opt-dismode = 'N'.
*  s_opt-defsize = 'X'.
*  s_opt-updmode = 'S'.
*  s_opt-nobinpt = 'X'.
*  s_opt-racommit = 'X'.
  REFRESH:r_spmon,ti_alv1,ti_char,r_spmon_m1,r_fecha1.
*Se obtiene el periodo actual
  CLEAR:r_spmon_m1.
  r_spmon_m1-sign = 'I'.
  r_spmon_m1-option = 'EQ'.
  r_spmon_m1-low+0(4) = sy-datum+0(4).
  r_spmon_m1-low+4(2) = sy-datum+4(2).
*  r_spmon_m1-high+0(4) = sy-datum+0(4).
*  r_spmon_m1-high+4(2) = sy-datum+4(2).
  APPEND r_spmon_m1.
  CLEAR:r_fecha1.
  r_fecha1-sign = 'I'.
  r_fecha1-option = 'BT'.
  r_fecha1-low = sy-datum.
  r_fecha1-low+6(2) = '01'.
  CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
    EXPORTING
      im_date              = r_fecha1-low
    IMPORTING
*     EX_DATE_IS_MONTHEND  =
      ex_last_day_of_month = r_fecha1-high.
  APPEND r_fecha1.
  CLEAR:l_perio,l_anio.
  IF sy-datum+4(2) EQ '12'.
    l_perio = '01'.
    l_anio = sy-datum+0(4) + 1.
  ELSE.
    l_perio = sy-datum+4(2) + 1.
    l_anio  = sy-datum+0(4).
  ENDIF.
  CLEAR:r_spmon.
  r_spmon-sign = 'I'.
  r_spmon-option = 'EQ'.
  r_spmon-low+0(4) = l_anio.
  r_spmon-low+4(2) = l_perio.
  r_spmon-high+0(4) = l_anio.
  r_spmon-high+4(2) = l_perio.
  APPEND r_spmon.
  CLEAR:l_datum.
  l_datum+4(2) = l_perio.
  l_datum+0(4) = l_anio.
  l_datum+6(2) = '01'.
  DO 5 TIMES.
    IF l_perio GT 12.
      ADD 1 TO l_anio.
      l_perio = 1.
    ELSE.
      ADD 1 TO l_perio.
    ENDIF.
    CLEAR:r_spmon.
    r_spmon-sign = 'I'.
    r_spmon-option = 'EQ'.
    r_spmon-low+0(4) = l_anio.
    r_spmon-low+4(2) = l_perio.
    r_spmon-high+0(4) = l_anio.
    r_spmon-high+4(2) = l_perio.
    APPEND r_spmon.
  ENDDO.
  REFRESH:ti_s700e,ti_s700e_cen,ti_matnr.
  SELECT *  INTO TABLE ti_s700e
      FROM s700e
    WHERE bukrs EQ p_bukrs
      AND prgrp IN s_forma
      AND matnr IN s_matnr.
  ti_s700e_cen[] = ti_s700e[].
  DELETE ti_s700e WHERE werks NE space.
  DELETE ti_s700e_cen WHERE werks EQ space.
  REFRESH:ti_s700e_mat.
  SELECT * INTO TABLE ti_s700
  FROM s700
    WHERE vrsio EQ 'A00'
    AND spmon IN r_spmon
    AND bukrs EQ p_bukrs
    AND prgrp IN s_forma.
  DELETE ti_s700e WHERE matnr EQ space.
  ti_s700e_mat[] = ti_s700e[].
  SORT ti_s700e_mat BY matnr.
  DELETE ADJACENT DUPLICATES FROM ti_s700e_mat COMPARING matnr.
  IF NOT ti_s700e_cen[] IS INITIAL.
    SELECT matnr werks dispo
      INTO TABLE ti_matnr
      FROM marc FOR ALL ENTRIES IN ti_s700e_cen
      WHERE matnr EQ ti_s700e_cen-matnr
      AND werks EQ ti_s700e_cen-werks
      AND dispo IN s_dispo.
    SELECT matnr werks lgort labst umlme insme
      INTO TABLE ti_mard
      FROM mard FOR ALL ENTRIES IN ti_s700e_cen
      WHERE matnr EQ ti_s700e_cen-matnr
      AND werks EQ ti_s700e_cen-werks.
    REFRESH:ti_pbim,ti_pbed.
    SELECT  matnr werks bedae versb pbdnr vervs bdzei
    INTO TABLE ti_pbim
    FROM pbim FOR ALL ENTRIES IN ti_s700e_cen
    WHERE matnr EQ ti_s700e_cen-matnr
      AND werks EQ ti_s700e_cen-werks.
*      AND versb = '00'.
    DELETE ti_pbim WHERE vervs = space.
    ti_pbim00[] = ti_pbim.
    DELETE ti_pbim00 WHERE versb NE '00'.
*    IF NOT ti_pbim[] IS INITIAL.
*      SELECT bdzei pdatu meins plnmg entmg
*        INTO TABLE ti_pbed
*        FROM pbed
*        FOR ALL ENTRIES IN ti_pbim
*        WHERE bdzei = ti_pbim-bdzei
*          AND perxx IN r_spmon.
*    ENDIF.
*Se obtiene las necesidades del mes 1 y los pedidos asignados.
    REFRESH:ti_pbed1.
    IF NOT ti_pbim[] IS INITIAL.
      SELECT bdzei pdatu meins plnmg entmg
        INTO TABLE ti_pbed1
        FROM pbed
        FOR ALL ENTRIES IN ti_pbim
        WHERE bdzei = ti_pbim-bdzei
          AND pdatu IN r_fecha1.
*          AND perxx IN r_spmon_m1.
*Se obtiene los pedidos de ventas del periodo actual
      IF NOT ti_s700e_cen IS INITIAL.
        REFRESH:ti_vbbe.
        SELECT vbeln posnr etenr matnr werks omeng vmeng
          INTO TABLE ti_vbbe
          FROM vbbe
           FOR ALL ENTRIES IN ti_s700e_cen
         WHERE matnr = ti_s700e_cen-matnr
           AND werks = ti_s700e_cen-werks
           AND mbdat IN r_fecha1.
      ENDIF.
    ENDIF.
  ENDIF.
  REFRESH:ti_maktx.
  IF NOT ti_s700e_mat IS INITIAL.
    SELECT matnr maktx INTO TABLE ti_maktx
      FROM makt FOR ALL ENTRIES IN ti_s700e_mat
      WHERE matnr EQ ti_s700e_mat-matnr
      AND spras EQ sy-langu.
  ENDIF.

*Se obtiene almacenes no planificables
  REFRESH:r_werks.
  LOOP AT ti_s700e_cen INTO st_s700e.
    CLEAR:r_werks.
    r_werks-option = 'EQ'.
    r_werks-sign = 'I'.
    r_werks-low = st_s700e-werks.
    COLLECT r_werks.
  ENDLOOP.
  IF NOT r_werks[] IS INITIAL.
    SELECT werks lgort diskz
    INTO TABLE ti_t001l
      FROM t001l
      WHERE werks IN r_werks.
  ENDIF.
  DELETE ti_t001l WHERE diskz NE '1'.
ENDFORM. " SELECCIONA_DATOS
*&---------------------------------------------------------------------*
*&      Form  PROCESA_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM procesa_datos .
  DATA:l_menge TYPE mseg-menge.
  REFRESH:ti_mard2,ti_vbbe_ac,ti_nec_p.
*Se obtiene la cantidad de venta pendiente por entrega del periodo actual
  LOOP AT ti_vbbe INTO st_vbbe.
    CLEAR:st_vbbe-vbeln,
         st_vbbe-posnr,
         st_vbbe-etenr.
    COLLECT st_vbbe INTO ti_vbbe_ac.
  ENDLOOP.
*Se obtiene la necesidad pendiente del periodo actual
  LOOP AT ti_pbed1 INTO st_pbed.
    CLEAR:st_nec_p.
    READ TABLE ti_pbim INTO st_pbim WITH KEY bdzei = st_pbed-bdzei.
    IF sy-subrc EQ 0.
      st_nec_p-matnr = st_pbim-matnr.
      st_nec_p-werks = st_pbim-werks.
    ENDIF.
    st_nec_p-plnmg = st_pbed-plnmg.
    COLLECT st_nec_p INTO ti_nec_p.
  ENDLOOP.
*Se obtiene stock de los almacenes.
  LOOP AT ti_mard INTO st_mard.
    READ TABLE ti_t001l INTO st_t001l WITH KEY werks = st_mard-werks
                                               lgort = st_mard-lgort.
    IF sy-subrc NE 0.
* Se verifica que el almacén no se encuentre en tabla de almacenes no planificable
      CLEAR:st_mard2.
      st_mard2-matnr = st_mard-matnr.
      st_mard2-werks = st_mard-werks.
      st_mard2-labst = st_mard-labst + st_mard-umlme + st_mard-insme.
      COLLECT st_mard2 INTO ti_mard2.
    ENDIF.
  ENDLOOP.
  LOOP AT ti_s700e INTO st_s700e.
    CLEAR:st_alv1.
    st_alv1-bukrs = st_s700e-bukrs.
    st_alv1-prgrp = st_s700e-prgrp.
    st_alv1-matnr = st_s700e-matnr.
    st_alv1-meins = st_s700e-basme.
    READ TABLE ti_mard2 INTO st_mard2 WITH KEY matnr = st_s700e-matnr
                                               werks = '1010'.
    IF sy-subrc EQ 0.
      st_alv1-labst1010 = st_mard2-labst.
    ENDIF.
    READ TABLE ti_mard2 INTO st_mard2 WITH KEY matnr = st_s700e-matnr
                                               werks = '1020'.
    IF sy-subrc EQ 0.
      st_alv1-labst1020 = st_mard2-labst.
    ENDIF.
    READ TABLE ti_mard2 INTO st_mard2 WITH KEY matnr = st_s700e-matnr
                                               werks = '1091'.
    IF sy-subrc EQ 0.
      st_alv1-labst1091 = st_mard2-labst.
    ENDIF.
****SE agregan centros de trebol
    READ TABLE ti_mard2 INTO st_mard2 WITH KEY matnr = st_s700e-matnr
                                               werks = '2010'.
    IF sy-subrc EQ 0.
      st_alv1-labst2010 = st_mard2-labst.
    ENDIF.
    READ TABLE ti_mard2 INTO st_mard2 WITH KEY matnr = st_s700e-matnr
                                               werks = '2020'.
    IF sy-subrc EQ 0.
      st_alv1-labst2020 = st_mard2-labst.
    ENDIF.
*****
    LOOP AT r_spmon.
      gl_tabix = sy-tabix.
      READ TABLE ti_s700 INTO st_s700 WITH KEY spmon = r_spmon-low
                                               bukrs = st_s700e-bukrs
                                               prgrp = st_s700e-prgrp
                                               matnr = st_s700e-matnr.
      IF sy-subrc EQ 0.
        CASE gl_tabix.
          WHEN 1.
            st_alv1-nec_dm1 = st_s700-absat.
*            st_alv1-znecf1 = st_s700-produ.
          WHEN 2.
            st_alv1-nec_dm2 = st_s700-absat.
*            st_alv1-znecf2 = st_s700-produ.
          WHEN 3.
            st_alv1-nec_dm3 = st_s700-absat.
*            st_alv1-znecf3 = st_s700-produ.
          WHEN 4.
            st_alv1-nec_dm4 = st_s700-absat.
*            st_alv1-znecf4 = st_s700-produ.
          WHEN 5.
            st_alv1-nec_dm5 = st_s700-absat.
*            st_alv1-znecf5 = st_s700-produ.
          WHEN 6.
            st_alv1-nec_dm6 = st_s700-absat.
*            st_alv1-znecf6 = st_s700-produ.
        ENDCASE.
      ENDIF.
    ENDLOOP.
    APPEND st_alv1 TO ti_alv1.
*    st_alv1-maktx
  ENDLOOP.
  LOOP AT ti_alv1 ASSIGNING <fs_alv>.
    READ TABLE ti_maktx INTO st_maktx WITH KEY matnr = <fs_alv>-matnr.
    IF sy-subrc EQ 0.
      <fs_alv>-maktx = st_maktx-maktx.
    ENDIF.
    PERFORM obtiene_nec_pend USING <fs_alv>-matnr
                                   '1010'
                             CHANGING <fs_alv>-nec_p1010.

    PERFORM obtiene_nec_pend USING <fs_alv>-matnr
                                   '1020'
                             CHANGING <fs_alv>-nec_p1020.
    PERFORM obtiene_nec_pend USING <fs_alv>-matnr
                                   '1091'
                             CHANGING <fs_alv>-nec_p1091.

    PERFORM obtiene_atp USING <fs_alv>-matnr
                              '1010'
                              p_re
                        CHANGING <fs_alv>-atp1010.
    PERFORM obtiene_atp USING <fs_alv>-matnr
                              '1020'
                              p_re
                        CHANGING <fs_alv>-atp1020.
    PERFORM obtiene_atp USING <fs_alv>-matnr
                              '1091'
                              p_re
                        CHANGING <fs_alv>-atp1091.
****SE agregan centros de TREBOL.
    PERFORM obtiene_nec_pend USING <fs_alv>-matnr
                                   '2010'
                             CHANGING <fs_alv>-nec_p2010.

    PERFORM obtiene_nec_pend USING <fs_alv>-matnr
                                   '2020'
                             CHANGING <fs_alv>-nec_p2020.
    PERFORM obtiene_atp USING <fs_alv>-matnr
                              '2010'
                              p_re
                        CHANGING <fs_alv>-atp2010.
    PERFORM obtiene_atp USING <fs_alv>-matnr
                              '2020'
                              p_re
                        CHANGING <fs_alv>-atp2020.
****
    PERFORM obtiene_centro_fav USING <fs_alv>-matnr
                              CHANGING <fs_alv>-werks_f.

    CASE <fs_alv>-werks_f.
      WHEN '1010'.
*        <fs_alv>-saldo = <fs_alv>-atp1010 - <fs_alv>-nec_p1010.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1020 - <fs_alv>-nec_p1020.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1091 - <fs_alv>-nec_p1091.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
      WHEN '1020'.
*        <fs_alv>-saldo = <fs_alv>-atp1020 - <fs_alv>-nec_p1020.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1010 - <fs_alv>-nec_p1010.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1091 - <fs_alv>-nec_p1091.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
      WHEN '1091'.
*        <fs_alv>-saldo = <fs_alv>-atp1091 - <fs_alv>-nec_p1091.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1010 - <fs_alv>-nec_p1010.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp1020 - <fs_alv>-nec_p1020.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
***Se agregan centros de trebol.
      WHEN '2010'.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp2020 - <fs_alv>-nec_p2020.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
      WHEN '2020'.
        CLEAR: l_menge.
        l_menge = <fs_alv>-atp2010 - <fs_alv>-nec_p2010.
        IF l_menge GT 0.
          <fs_alv>-saldo = <fs_alv>-saldo + l_menge.
        ENDIF.
    ENDCASE.
****
*    <fs_alv>-saldo = <fs_alv>-atp1010 + <fs_alv>-atp1020 + <fs_alv>-atp1091.
  ENDLOOP.
ENDFORM. " PROCESA_DATOS
