*&      Form  CREAR_OBJETOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM crear_objetos .
  CREATE OBJECT: o_ccmain
                         EXPORTING
                           container_name = 'CC_MAIN'.
  CREATE OBJECT o_alv_grid1
    EXPORTING
      i_parent          = o_ccmain
    EXCEPTIONS
      error_cntl_create = 1
      error_cntl_init   = 2
      error_cntl_link   = 3
      error_dp_create   = 4
      OTHERS            = 5.
  CALL METHOD o_alv_grid1->register_edit_event
    EXPORTING
      i_event_id = cl_gui_alv_grid=>mc_evt_enter
    EXCEPTIONS
      error      = 1
      OTHERS     = 2.
  IF sy-subrc <> 0.
*     MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
*                WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.
ENDFORM. " CREAR_OBJETOS
*&---------------------------------------------------------------------*
*&      Form  MUESTRA_OBJETOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM muestra_objetos .
  REFRESH: lt_exclude.
  CLEAR: lw_layout, lw_varian.
  lw_layout-zebra       = 'X'.
  lw_layout-cwidth_opt  = 'X'.
  lw_varian-report = sy-repid.
*  PERFORM exclude_tb_functions CHANGING lt_exclude.

  CALL METHOD o_alv_grid1->set_table_for_first_display
    EXPORTING
      i_save                        = 'A'
      i_default                     = 'X'
      is_variant                    = lw_varian
      is_layout                     = lw_layout
      it_toolbar_excluding          = lt_exclude
    CHANGING
      it_outtab                     = ti_alv1
      it_fieldcatalog               = ti_fcat1
    EXCEPTIONS
      invalid_parameter_combination = 1
      program_error                 = 2
      too_many_lines                = 3
      OTHERS                        = 4.
ENDFORM. " MUESTRA_OBJETOS
*&---------------------------------------------------------------------*
*&      Form  OBTIENE_ATP
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_<FS_ALV>_MATNR  text
*      -->P_0877   text
*      -->P_0878   text
*      <--P_<FS_ALV>_ATP1010  text
*----------------------------------------------------------------------*
FORM obtiene_atp USING pu_matnr
                           pu_werks
                           pu_regla
                  CHANGING pc_menge.
  DATA: l_fecha TYPE sy-datum,
        l_fecha2 TYPE sy-datum.
  DATA: st_atpca TYPE atpca,
          st_atpcs TYPE atpcs,
          l_menge_e TYPE mseg-menge,
          l_menge_s TYPE mseg-menge,
          l_menge TYPE mseg-menge,
          st_atpmat TYPE atpmat,
          st_atpds TYPE atpds,
          ti_atpcs LIKE STANDARD TABLE OF st_atpcs,
          ti_atpds LIKE STANDARD TABLE OF st_atpds,
          st_atpds2 TYPE atpds,
          ti_atpds2 LIKE STANDARD TABLE OF st_atpds,
          ti_atpmat LIKE STANDARD TABLE OF st_atpmat.
  REFRESH:ti_atpcs,ti_atpds,ti_atpmat.
  CLEAR:st_atpcs,st_atpca.
  st_atpcs-matnr = pu_matnr.
  st_atpcs-werks = pu_werks.
*  st_atpcs-kdauf = pu_kdauf.
*  st_atpcs-kdpos = pu_kdpos.
  st_atpcs-prreg = pu_regla.
  st_atpcs-chmod = 'EXP'.
  st_atpcs-delkz = 'VC'.
*  st_atpcs-sobkz = 'E'.
  st_atpcs-bdter = sy-datum.
  st_atpcs-trtyp = 'A'.
  st_atpcs-xline = '1'.
  st_atpcs-resmd = 'X'.
  st_atpcs-chkflg    = 'X'.
  st_atpcs-idxatp    = '1'.
  APPEND st_atpcs TO ti_atpcs.
  st_atpca-anwdg = '8'.
  st_atpca-anwdg_orig = 'A'.
  st_atpca-azerg = 'T'.
  st_atpca-rdmod = 'A'.
  st_atpca-xenqmd = 'N'.
  CALL FUNCTION 'AVAILABILITY_CHECK'
* EXPORTING
*   P_SCHEDSH           =
*   P_SCHEDTR           =
    TABLES
*   P_ATPALLX           =
*   P_ATPASSRESX        =
*   P_ATPASSX           =
      p_atpcsx            = ti_atpcs
*   P_ATPCSX_R3         =
   p_atpdsx            = ti_atpds
*   P_ATPFIELDX         =
    p_atpmatx           = ti_atpmat
 CHANGING
   p_atpca             = st_atpca
*   P_ATPCB             =
*   P_ATPCC             =
   EXCEPTIONS
     error               = 1
     OTHERS              = 2
            .
  IF sy-subrc <> 0.
  ENDIF.
*  READ TABLE r_spmon INDEX 1.
*  IF sy-subrc EQ 0.
*    CLEAR:l_fecha,l_fecha2.
*    l_fecha+0(6) =  r_spmon-low.
*    l_fecha+6(2) = '01'.
  CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
    EXPORTING
      im_date              = sy-datum
    IMPORTING
*     EX_DATE_IS_MONTHEND  =
      ex_last_day_of_month = l_fecha2.
*  ENDIF.
  REFRESH:ti_atpds2.
  LOOP AT ti_atpds INTO st_atpds WHERE dat GT l_fecha2
                                  AND atpnr EQ space.
    CLEAR:st_atpds2.
    st_atpds2-sort1 = st_atpds-sort1.
    st_atpds2-qty_o = st_atpds-qty_o.
    COLLECT st_atpds2 INTO ti_atpds2.
  ENDLOOP.
  READ TABLE ti_atpcs INTO st_atpcs INDEX 1.
  IF sy-subrc EQ 0.
    IF NOT ti_atpds2[] IS INITIAL.
      CLEAR:l_menge_e,l_menge_s.
      READ TABLE ti_atpds2 INTO st_atpds2 WITH KEY sort1 = '1'.
      IF sy-subrc EQ 0.
        l_menge_e =  st_atpcs-sumzg - st_atpds2-qty_o.
      ELSE.
        l_menge_e =  st_atpcs-sumzg.
      ENDIF.
      READ TABLE ti_atpds2 INTO st_atpds2 WITH KEY sort1 = '2'.
      IF sy-subrc EQ 0.
        l_menge_s =  st_atpcs-sumag - st_atpds2-qty_o.
      ELSE.
        l_menge_s =  st_atpcs-sumag.
      ENDIF.
      pc_menge = l_menge_e - l_menge_s.
    ELSE.

      pc_menge = st_atpcs-sumzg - st_atpcs-sumag.
    ENDIF.
  ENDIF.

*  READ TABLE ti_atpmat INTO st_atpmat INDEX 1.
*  IF sy-subrc EQ 0.
*    IF st_atpmat-meins NE pu_meins_pt.
*      CLEAR:l_menge.
*      PERFORM convierte_unidad  USING    pu_matnr
*                                         st_atpmat-meins
*                                         pu_meins_pt
*                                         pc_menge
*                                CHANGING l_menge.
*      IF NOT l_menge IS INITIAL.
*        pc_menge = l_menge.
*      ENDIF.
*    ENDIF.
*  ENDIF.
ENDFORM. " OBTIENE_ATP
*&---------------------------------------------------------------------*
*&      Form  OBTIENE_CENTRO_FAV
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_<FS_ALV>_MATNR  text
*----------------------------------------------------------------------*
FORM obtiene_centro_fav USING pu_matnr
                        CHANGING pc_werks.
  DATA : u_object     TYPE ausp-objek.
  DATA: s_return TYPE bapiret2,
        t_return1 LIKE STANDARD TABLE OF s_return.
  READ TABLE ti_char TRANSPORTING NO FIELDS WITH KEY matnr = pu_matnr.
  IF sy-subrc EQ 0.
    READ TABLE ti_char INTO st_char WITH KEY matnr = pu_matnr
                                             charact = 'ZPP_CENTFAV'.
    IF sy-subrc EQ 0.
      pc_werks = st_char-value_char.
    ENDIF.
  ELSE.
    u_object+0(18)  = pu_matnr.
    CALL FUNCTION 'BAPI_OBJCL_GETDETAIL'
      EXPORTING
        objectkey       = u_object
        objecttable     = 'MARA'
        classnum        = 'ZMAT_CAR'
        classtype       = '001'
        keydate         = sy-datum
        language        = sy-langu
      TABLES
        allocvaluesnum  = i_caract_num
        allocvalueschar = i_caract_char
        allocvaluescurr = i_caract_curr
        return          = t_return1.
    LOOP AT i_caract_char INTO s_caract_char.
      CLEAR:st_char.
      st_char-matnr      =  pu_matnr.
      st_char-charact    =  s_caract_char-charact.
      st_char-value_char =  s_caract_char-value_char.
      APPEND st_char TO ti_char.
      IF s_caract_char-charact EQ 'ZPP_CENTFAV'.
        pc_werks = s_caract_char-value_char.
        EXIT.
      ENDIF.
    ENDLOOP.
*      MODIFY ct_ioheader FROM st_header.
  ENDIF.
ENDFORM. " OBTIENE_CENTRO_FAV
*&---------------------------------------------------------------------*
*&      Form  DISTRIBUYE_DEMANDA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM distribuye_demanda .
  DATA:l_menge TYPE mseg-menge,
        l_menge2 TYPE mseg-menge.
  LOOP AT ti_alv1 ASSIGNING <fs_alv>.
    CLEAR:l_menge.
    l_menge = <fs_alv>-nec_dm1   - <fs_alv>-saldo.
    IF l_menge GT 0.
      <fs_alv>-nec_cfm1 = l_menge.
      <fs_alv>-nec_cfm2 = <fs_alv>-nec_dm2.
      <fs_alv>-nec_cfm3 = <fs_alv>-nec_dm3.
      <fs_alv>-nec_cfm4 = <fs_alv>-nec_dm4.
      <fs_alv>-nec_cfm5 = <fs_alv>-nec_dm5.
      <fs_alv>-nec_cfm6 = <fs_alv>-nec_dm6.
    ELSE.
      CLEAR:<fs_alv>-nec_cfm1,l_menge2.
      l_menge2 = <fs_alv>-nec_dm2 + l_menge.
      l_menge = l_menge2.
      IF l_menge GT 0 .
        <fs_alv>-nec_cfm2 = l_menge.
        <fs_alv>-nec_cfm3 = <fs_alv>-nec_dm3.
        <fs_alv>-nec_cfm4 = <fs_alv>-nec_dm4.
        <fs_alv>-nec_cfm5 = <fs_alv>-nec_dm5.
        <fs_alv>-nec_cfm6 = <fs_alv>-nec_dm6.
      ELSE.
        CLEAR:<fs_alv>-nec_cfm2,l_menge2.
        l_menge2 = <fs_alv>-nec_dm3 + l_menge.
        l_menge = l_menge2.
        IF l_menge GT 0 .
          <fs_alv>-nec_cfm3 = l_menge.
          <fs_alv>-nec_cfm4 = <fs_alv>-nec_dm4.
          <fs_alv>-nec_cfm5 = <fs_alv>-nec_dm5.
          <fs_alv>-nec_cfm6 = <fs_alv>-nec_dm6.
        ELSE.
          CLEAR:<fs_alv>-nec_cfm3,l_menge2.
          l_menge2 = <fs_alv>-nec_dm4 + l_menge.
          l_menge = l_menge2.
          IF l_menge GT 0 .
            <fs_alv>-nec_cfm4 = l_menge.
            <fs_alv>-nec_cfm5 = <fs_alv>-nec_dm5.
            <fs_alv>-nec_cfm6 = <fs_alv>-nec_dm6.
          ELSE.
            CLEAR:<fs_alv>-nec_cfm4,l_menge2.
            l_menge2 = <fs_alv>-nec_dm5 + l_menge.
            l_menge = l_menge2.
            IF l_menge GT 0 .
              <fs_alv>-nec_cfm5 = l_menge.

              <fs_alv>-nec_cfm6 = <fs_alv>-nec_dm6.
            ELSE.
              CLEAR:<fs_alv>-nec_cfm5,l_menge2.
              l_menge2 = <fs_alv>-nec_dm6 + l_menge.
              l_menge = l_menge2.
              IF l_menge GT 0 .
                <fs_alv>-nec_cfm6 = l_menge.
              ELSE.
                CLEAR:<fs_alv>-nec_cfm6,l_menge2.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

    ENDIF.

  ENDLOOP.
ENDFORM. " DISTRIBUYE_DEMANDA
*&---------------------------------------------------------------------*
*&      Form  GENERA_NECESIDAD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM genera_necesidad.
  DATA: l_menge TYPE mseg-menge.
*  DATA: req_data LIKE bapisshdin OCCURS 0 WITH HEADER LINE.
  DATA:
        l_fecha TYPE sy-datum,
        l_fecha2 TYPE sy-datum.
  REFRESH: req_data,return,ti_alv1_2.
  ti_alv1_2[] = ti_alv1[].
  SORT ti_alv1_2 BY bukrs prgrp matnr.
  LOOP AT ti_alv1_2 INTO st_alv1_2.
    IF st_alv1_2-werks_f IS INITIAL.
      CLEAR:st_log.
      st_log-matnr = st_alv1_2-matnr.
      st_log-werks = st_alv1_2-werks_f.
      st_log-msgv1 = 'No se genera necesidades sin centro favorito'.
      st_log-id = c_w.
      MOVE: 'W' TO st_log-msgtyp.
      APPEND st_log TO ti_log.
      CONTINUE.
    ENDIF.
*    CLEAR:st_alv1.
*    MOVE st_alv1_2 TO st_alv1.
    REFRESH: req_data,i_requirements_schedule_in.
    REFRESH: req_data2,i_requirements_schedule_in2.
    REFRESH: req_data3,i_requirements_schedule_in3.
    READ TABLE r_spmon INDEX 1.
    IF sy-subrc EQ 0.
      CLEAR:l_fecha,l_fecha2.
      l_fecha+0(6) =  r_spmon-low.
      l_fecha+6(2) = '01'.
      CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
        EXPORTING
          im_date              = l_fecha
        IMPORTING
*         EX_DATE_IS_MONTHEND  =
          ex_last_day_of_month = l_fecha2.
      CLEAR:req_data.
      req_data-date_type = 1.
      req_data-req_date = l_fecha2.
      req_data-req_qty = st_alv1_2-nec_cfm1.
      APPEND req_data.

      i_requirements_schedule_in-date_type = '1'.
      i_requirements_schedule_in-req_date  = l_fecha2.
      i_requirements_schedule_in-req_qty   = st_alv1_2-nec_cfm1.
      i_requirements_schedule_in-unit      = st_alv1_2-meins.
      APPEND i_requirements_schedule_in.

      CASE p_bukrs.
        WHEN '1000'.
          PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
                                                st_alv1_2-atp1010
                                                st_alv1_2-atp1020
                                                st_alv1_2-atp1091
                                                l_fecha2 "LV
                                                st_alv1_2-meins "LV
                                                st_alv1_2-nec_p1010"LV
                                                st_alv1_2-nec_p1020"LV
                                                st_alv1_2-nec_p1091."LV
        WHEN '2000'.
          PERFORM lleba_bapi_cent_nofav2000 USING st_alv1_2-werks_f
                                                  st_alv1_2-atp2010
                                                st_alv1_2-atp2020
*                                                st_alv1_2-atp1091
                                                l_fecha2
                                                st_alv1_2-meins
                                                st_alv1_2-nec_p2010
                                                st_alv1_2-nec_p2020.
        WHEN OTHERS.
      ENDCASE.

    ENDIF.

    READ TABLE r_spmon INDEX 2.
    IF sy-subrc EQ 0.
      CLEAR:l_fecha,l_fecha2.
      l_fecha+0(6) =  r_spmon-low.
      l_fecha+6(2) = '01'.
      CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
        EXPORTING
          im_date              = l_fecha
        IMPORTING
*         EX_DATE_IS_MONTHEND  =
          ex_last_day_of_month = l_fecha2.
      CLEAR:req_data.
      req_data-date_type = 1.
      req_data-req_date = l_fecha2.
      req_data-req_qty = st_alv1_2-nec_cfm2.
      APPEND req_data.
      i_requirements_schedule_in-date_type = '1'.
      i_requirements_schedule_in-req_date  = l_fecha2.
      i_requirements_schedule_in-req_qty   = st_alv1_2-nec_cfm2.
      i_requirements_schedule_in-unit      = st_alv1_2-meins.
      APPEND i_requirements_schedule_in.
*      PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
*                                          st_alv1_2-atp1010
*                                          st_alv1_2-atp1020
*                                          st_alv1_2-atp1091
*                                          l_fecha2 "LV
*                                          st_alv1_2-meins"LV
*                                          st_alv1_2-nec_p1010"LV
*                                          st_alv1_2-nec_p1020"LV
*                                          st_alv1_2-nec_p1091."LV
      CASE p_bukrs.
        WHEN '1000'.
*Sólo para el primer periodo se verifica, para los demas periodos necesidad en centro favorito igual a 0.
          CLEAR:l_menge.
          PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
                                                l_menge
                                                l_menge
                                                l_menge
                                                l_fecha2 "LV
                                                st_alv1_2-meins "LV
                                                l_menge
                                                l_menge
                                                l_menge.
        WHEN '2000'.
*Sólo para el primer periodo se verifica, para los demas periodos necesidad en centro favorito igual a 0.
          CLEAR:l_menge.
          PERFORM lleba_bapi_cent_nofav2000 USING st_alv1_2-werks_f
                                                  l_menge
                                                  l_menge
                                                  l_fecha2
                                                  st_alv1_2-meins
                                                  l_menge
                                                  l_menge.
        WHEN OTHERS.
      ENDCASE.
    ENDIF.
*    CLEAR:req_data.
*    req_data-date_type = 1.
*    req_data-req_date = '20070723'.
*    req_data-req_qty = st_alv1_2-nec_cfm2.
*    APPEND req_data.
    READ TABLE r_spmon INDEX 3.
    IF sy-subrc EQ 0.
      CLEAR:l_fecha,l_fecha2.
      l_fecha+0(6) =  r_spmon-low.
      l_fecha+6(2) = '01'.
      CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
        EXPORTING
          im_date              = l_fecha
        IMPORTING
*         EX_DATE_IS_MONTHEND  =
          ex_last_day_of_month = l_fecha2.
      CLEAR:req_data.
      req_data-date_type = 1.
      req_data-req_date = l_fecha2.
      req_data-req_qty = st_alv1_2-nec_cfm3.
      APPEND req_data.
      i_requirements_schedule_in-date_type = '1'.
      i_requirements_schedule_in-req_date  = l_fecha2.
      i_requirements_schedule_in-req_qty   = st_alv1_2-nec_cfm3.
      i_requirements_schedule_in-unit      = st_alv1_2-meins.
      APPEND i_requirements_schedule_in.
*      PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
*                                          st_alv1_2-atp1010
*                                          st_alv1_2-atp1020
*                                          st_alv1_2-atp1091
*                                          l_fecha2 "LV
*                                          st_alv1_2-meins"LV
*                                          st_alv1_2-nec_p1010"LV
*                                          st_alv1_2-nec_p1020"LV
*                                          st_alv1_2-nec_p1091."LV
      CASE p_bukrs.
        WHEN '1000'.
*Sólo para el primer periodo se verifica, para los demas periodos necesidad en centro favorito igual a 0.
          CLEAR:l_menge.
          PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
                                                l_menge
                                                l_menge
                                                l_menge
                                                l_fecha2 "LV
                                                st_alv1_2-meins "LV
                                                l_menge
                                                l_menge
                                                l_menge.
        WHEN '2000'.
*Sólo para el primer periodo se verifica, para los demas periodos necesidad en centro favorito igual a 0.
          CLEAR:l_menge.
          PERFORM lleba_bapi_cent_nofav2000 USING st_alv1_2-werks_f
                                                  l_menge
                                                  l_menge
                                                l_fecha2
                                                st_alv1_2-meins
                                                l_menge
                                                l_menge.
        WHEN OTHERS.
      ENDCASE.
    ENDIF.
    READ TABLE r_spmon INDEX 4.
    IF sy-subrc EQ 0.
      CLEAR:l_fecha,l_fecha2.
      l_fecha+0(6) =  r_spmon-low.
      l_fecha+6(2) = '01'.
      CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
        EXPORTING
          im_date              = l_fecha
        IMPORTING
*         EX_DATE_IS_MONTHEND  =
          ex_last_day_of_month = l_fecha2.
      CLEAR:req_data.
      req_data-date_type = 1.
      req_data-req_date = l_fecha2.
      req_data-req_qty = st_alv1_2-nec_cfm4.
      APPEND req_data.
      i_requirements_schedule_in-date_type = '1'.
      i_requirements_schedule_in-req_date  = l_fecha2.
      i_requirements_schedule_in-req_qty   = st_alv1_2-nec_cfm4.
      i_requirements_schedule_in-unit      = st_alv1_2-meins.
      APPEND i_requirements_schedule_in.
*      PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
*                                          st_alv1_2-atp1010
*                                          st_alv1_2-atp1020
*                                          st_alv1_2-atp1091
*                                          l_fecha2 "LV
*                                          st_alv1_2-meins"LV
*                                          st_alv1_2-nec_p1010"LV
*                                          st_alv1_2-nec_p1020"LV
*                                          st_alv1_2-nec_p1091."LV
      CASE p_bukrs.
        WHEN '1000'.
*Sólo para el primer periodo se verifica, para los demas periodos necesidad en centro favorito igual a 0.
          CLEAR:l_menge.
          PERFORM lleba_bapi_cent_nofav USING st_alv1_2-werks_f
                                                l_menge
                                                l_menge
                                                l_menge
                                                l_fecha2 "LV
