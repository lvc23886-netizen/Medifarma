*&---------------------------------------------------------------------*
*&      Form  MODIFICA_NECESIDAD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM modifica_necesidad USING pu_matnr
                              pu_werks
                              .
  DATA: gwa_requirement_param         LIKE cm60r.
  CLEAR: gwa_requirement_param.
  gwa_requirement_param-status = 'X'.
  gwa_requirement_param-trtyp = 'X'.
  gwa_requirement_param-syncron = 'X'.
  CALL FUNCTION 'BAPI_REQUIREMENTS_CHANGE'
        EXPORTING
          material                       = pu_matnr
          plant                          = pu_werks
          requirementstype               = 'VSF'
          version                        = '00'
          reqmtsplannumber               = st_pbim-pbdnr
          vers_activ                     = 'X'
          requirement_param              = gwa_requirement_param
*   MRP_AREA                       =
         do_commit                      = ' '
         update_mode                    = 'X'
         delete_old                     = 'X'
*   NO_WITHDR                      = ' '
*   MATERIAL_EVG                   =
* IMPORTING
*   REQUIREMENT_ITEM_OUT           =
        TABLES
         requirements_schedule_in       = req_data[]
*   REQUIREMENTS_CHAR_IN           =
          return                         = return[].
  IF return[] IS INITIAL.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.
    CLEAR:st_log.
    st_log-matnr = pu_matnr.
    st_log-werks = pu_werks.
    st_log-msgv1 = 'Se generó las necesidades correctamente'.
    st_log-id = c_i.
    MOVE: 'I' TO st_log-msgtyp.
*              return-number  TO st_log-msgnr,
*              return-id  TO st_log-msgid.
    APPEND st_log TO ti_log.
  ELSE.
    LOOP AT return.
      CLEAR:st_log.
      st_log-matnr = pu_matnr.
      st_log-werks = pu_werks.
      st_log-msgv1 = return-message.
      st_log-id = c_e.
      MOVE: return-type TO st_log-msgtyp,
              return-number  TO st_log-msgnr,
              return-id  TO st_log-msgid.
      APPEND st_log TO ti_log.
    ENDLOOP.
  ENDIF.
ENDFORM. " MODIFICA_NECESIDAD
*&---------------------------------------------------------------------*
*&      Form  CREA_NECESIDAD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM crea_necesidad USING pu_matnr
                          pu_werks.
  CLEAR w_bapisitemr.
  w_bapisitemr-material   = pu_matnr.
  w_bapisitemr-plant      = pu_werks.
  w_bapisitemr-requ_type  = 'VSF'.
  w_bapisitemr-version    = '00'.
  w_bapisitemr-vers_activ = 'X'.
*  w_bapisitemr-req_number = c_reqmtsplannumber.


  CALL FUNCTION 'BAPI_REQUIREMENTS_CREATE'
    EXPORTING
      requirements_item        = w_bapisitemr
    TABLES
      requirements_schedule_in = i_requirements_schedule_in
      return                   = i_bapireturn1.
ENDFORM. " CREA_NECESIDAD
*&---------------------------------------------------------------------*
*&      Form  MUESTRA_LOG
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM muestra_log .
  CLEAR: st_layout_log.
  st_layout_log-colwidth_optimize = 'X'.
  PERFORM f_fieldcat_log_pl.
  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      is_layout             = st_layout_log
      it_fieldcat           = ti_fcat_log[]
*     i_screen_start_column = 20
*     i_screen_start_line   = 5
*     i_screen_end_column   = 120
*     i_screen_end_line     = 15
    TABLES
      t_outtab              = ti_log[]
    EXCEPTIONS
      program_error         = 1
      OTHERS                = 2.
ENDFORM. " MUESTRA_LOG
*&---------------------------------------------------------------------*
*&      Form  F_FIELDCAT_LOG_PL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_fieldcat_log_pl .
  DATA: vl_pos TYPE i.
  REFRESH ti_fcat_log[].
  CLEAR vl_pos.
  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'ID'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Semaf.'.
  st_fcat_log-ref_fieldname  = 'ID'.
  st_fcat_log-ref_tabname  = 'ICON'.
  APPEND st_fcat_log TO ti_fcat_log.
*  CLEAR st_fcat_log.
*  ADD 1 TO vl_pos.
*  st_fcat_log-col_pos    = vl_pos.
*  st_fcat_log-fieldname  = 'ZMODELO'.
*  st_fcat_log-tabname    = 'TI_LOG'.
*  st_fcat_log-seltext_l  = 'Grupo prod.'.
*  APPEND st_fcat_log TO ti_fcat_log.
  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'MATNR'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Material'.
  APPEND st_fcat_log TO ti_fcat_log.
  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'WERKS'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Centro'.
  APPEND st_fcat_log TO ti_fcat_log.
*  CLEAR st_fcat_log.
*  ADD 1 TO vl_pos.
*  st_fcat_log-col_pos    = vl_pos.
*  st_fcat_log-fieldname  = 'ZMES'.
*  st_fcat_log-tabname    = 'TI_LOG'.
*  st_fcat_log-seltext_l  = 'Mes'.
*  APPEND st_fcat_log TO ti_fcat_log.
*  CLEAR st_fcat_log.
*  CLEAR st_fcat_log.
*  ADD 1 TO vl_pos.
*  st_fcat_log-col_pos    = vl_pos.
*  st_fcat_log-fieldname  = 'MENGE'.
*  st_fcat_log-tabname    = 'TI_LOG'.
*  st_fcat_log-seltext_l  = 'Cantidad'.
*  APPEND st_fcat_log TO ti_fcat_log.
  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'MSGTYP'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Tipo'.
  APPEND st_fcat_log TO ti_fcat_log.

  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'MSGID'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'ID mensaje'.
  APPEND st_fcat_log TO ti_fcat_log.

  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'MSGNR'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Nro.Msj.'.
  APPEND st_fcat_log TO ti_fcat_log.

  CLEAR st_fcat_log.
  ADD 1 TO vl_pos.
  st_fcat_log-col_pos    = vl_pos.
  st_fcat_log-fieldname  = 'MSGV1'.
  st_fcat_log-tabname    = 'TI_LOG'.
  st_fcat_log-seltext_l  = 'Mensaje'.
  APPEND st_fcat_log TO ti_fcat_log.
ENDFORM. " F_FIELDCAT_LOG_PL
*&---------------------------------------------------------------------*
*&      Form  OBTIENE_NEC_PEND
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_<FS_ALV>_MATNR  text
*      -->P_1560   text
*----------------------------------------------------------------------*
FORM obtiene_nec_pend USING pu_matnr
                             pu_werks
                    CHANGING pc_menge.
*Se obtiene la necesidad pendiente del mes.
  READ TABLE ti_nec_p INTO st_nec_p WITH KEY matnr = pu_matnr
                                             werks = pu_werks.
  IF sy-subrc EQ 0.
    IF st_nec_p-plnmg GT 0.
      READ TABLE ti_vbbe_ac INTO st_vbbe WITH KEY matnr = pu_matnr
                                                 werks = pu_werks.
*Se obtiene los pedidos pendientes que disminuyen la necesidad pendiente del mes.
      IF sy-subrc EQ 0.

        pc_menge = st_nec_p-plnmg - st_vbbe-omeng.
        IF pc_menge LT 0.
          CLEAR:pc_menge.
        ENDIF.
      ELSE.
        pc_menge = st_nec_p-plnmg.
      ENDIF.
    ENDIF.
  ENDIF.



ENDFORM. " OBTIENE_NEC_PEND
