*&---------------------------------------------------------------------*
*&      Module  STATUS_0100  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'ST_100'.
  SET TITLEBAR 'TB_100'.
  IF o_ccmain IS INITIAL.
    PERFORM llena_fieldcat.
    PERFORM crear_objetos.
    PERFORM muestra_objetos.

  ELSE.
    CALL METHOD: o_alv_grid1->refresh_table_display.
  ENDIF.
ENDMODULE. " STATUS_0100 OUTPUT
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  CASE sy-ucomm.
    WHEN 'EXIT' OR 'CANC' OR 'BACK'.
      CLEAR:gl_mensaje.
      CONCATENATE 'No se guardaran los cambios' '¿Desea salir?'
             INTO gl_mensaje SEPARATED BY space.
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar              = 'Confirmación'
          text_question         = gl_mensaje
          icon_button_1         = '1'
          text_button_1         = 'Si'
          default_button        = '1'
          display_cancel_button = 'X'
          start_column          = 25
          start_row             = 6
        IMPORTING
          answer                = gl_ans
        EXCEPTIONS
          text_not_found        = 1
          OTHERS                = 2.
      IF gl_ans = '1' AND sy-subrc EQ 0.
        LEAVE TO SCREEN 0.
      ENDIF.
    WHEN 'SAVE'.
      REFRESH: ti_log.
      PERFORM genera_necesidad.
    WHEN 'BT_DISTRIB'.
      PERFORM distribuye_demanda.
  ENDCASE.
ENDMODULE. " USER_COMMAND_0100 INPUT
