                                                  l_menge
                                                l_fecha2
                                                st_alv1_2-meins
                                                l_menge
                                                l_menge.
        WHEN OTHERS.
      ENDCASE.
    ENDIF.
*    CLEAR:req_data.
*    req_data-date_type = 1.
*    req_data-req_date = '20070723'.
*    req_data-req_qty = st_alv1_2-nec_cfm4.
*    APPEND req_data.
