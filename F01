form add_event .

  data: ls_event type slis_alv_event.
  ls_event-name = 'TOP_OF_PAGE'.
  ls_event-form = 'TOP_OF_PAGE'.
  append ls_event to gt_events.

endform.


form top_of_page.
  data: lt_list_commentary type slis_t_listheader,
        ls_list_commentary type slis_listheader.

  ls_list_commentary-typ = 'H'.
  ls_list_commentary-info = 'REPORTE DE COMPRAS - MEDIFARMA'.
  append ls_list_commentary to lt_list_commentary.

  ls_list_commentary-typ = 'S'.
  concatenate 'User:' sy-uname into ls_list_commentary-info separated by space.
  append ls_list_commentary to lt_list_commentary.

  ls_list_commentary-typ = 'S'.
  concatenate 'Date:' sy-datum into ls_list_commentary-info separated by space.
  append ls_list_commentary to lt_list_commentary.




  call function 'REUSE_ALV_COMMENTARY_WRITE'
    exporting
      it_list_commentary = lt_list_commentary.


endform.
*&---------------------------------------------------------------------*
*& Form get_data2
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
form get_data .
  data: lv_data type c,
        days    type  t5a4a-dlydy.
  data: t_lines like tline occurs 0 with header line.
  data: lc_name type thead-tdname.
  constants : lv_igv type c length 4 value '0.18'.
  constants : lc_101 type mseg-bwart value '101'.
  constants : lc_122 type mseg-bwart value '122'.
  field-symbols : <fs_estruc> like line of  gt_estructura .
  data : lv_pendiente  type ekpo-menge.
  types : begin of gty_ekko,
            bukrs    type ekko-bukrs,
            ebeln    type ekko-ebeln,
            ekorg    type ekko-ekorg,
            bedat    type ekko-bedat,
            lifnr    type ekko-lifnr,
            bsart    type ekko-bsart,
            aedat    type ekpo-aedat,
            frgke    type ekko-frgke,
            loekz    type ekpo-loekz,
            ebelp    type ekpo-ebelp,
            kostl    type ekpo-kostl,
            matnr    type ekpo-matnr,
            txz01    type ekpo-txz01,
            matkl    type ekpo-matkl,
            ernam    type ekko-ernam,
            werks    type ekpo-werks,
            banfn    type ekpo-banfn,
            bnfpo    type ekpo-bnfpo,
            afnam    type ekpo-afnam,
            zterm    type ekko-zterm,
            meins    type ekpo-meins,
            netpr    type ekpo-netpr,
            waers    type ekko-waers,
            peinh    type ekpo-peinh,
            menge    type ekpo-menge,
            ekgrp    type ekko-ekgrp,
            mwskz    type ekpo-mwskz,
            wkurs    type ekko-wkurs,
            inco1    type ekko-inco1,
            objectid type cdpos-objectid,
            bednr    type ekpo-bednr,
            elikz    type ekpo-elikz,
          end of gty_ekko .
  types : begin of gty_eban,
            banfn    type eban-banfn,
            bnfpo    type eban-bnfpo,
            frgdt    type eban-frgdt,
            badat    type eban-badat,
            loekz    type eban-loekz,
            ernam    type eban-ernam,
            objectid type cdpos-objectid,
          end of gty_eban .
  data : lt_data type standard table of gty_ekko .
  data : lt_eban type standard table of gty_eban .

  select ekko~bukrs,
         ekko~ebeln ,
         ekko~ekorg ,
         ekko~bedat,
         ekko~lifnr,
         ekko~bsart,
         ekpo~aedat,
         ekko~frgke,
         ekpo~loekz,
         ekpo~ebelp,
         ekpo~kostl,
         ekpo~matnr,
         ekpo~txz01,
         ekpo~matkl,
         ekko~ernam,
         ekpo~werks,
         ekpo~banfn,
         ekpo~bnfpo,
         ekpo~afnam,
         ekko~zterm,
         ekpo~meins,
         ekpo~netpr,
         ekko~waers,
         ekpo~peinh,
         ekpo~menge,
         ekko~ekgrp,
         ekpo~mwskz,
         ekko~wkurs,
         ekko~inco1,
         ekko~ebeln,
         ekpo~bednr,
         ekpo~elikz
     from ekko
  inner join ekpo on ( ekko~ebeln  =  ekpo~ebeln )
  into table @lt_data
  where ekko~bukrs eq @p_bukrs
    and ekko~ebeln in @s_ebeln
    and ekko~ekorg in @s_ekorg
    and ekko~aedat in @s_aedat
    and ekko~lifnr in @s_lifnr
    and ekko~bsart in @s_bsart
    and ekpo~werks in @s_werks
    and ekpo~matnr in @s_matnr
    and ekpo~matkl in @s_matkl
    and ekko~ernam in @s_ernam
    .

  if lt_data is not initial.
    data(lt_dat) = lt_data .
    delete lt_dat where banfn is initial and bnfpo is initial .
    "se obtiene la solped por posicion .
    select banfn,
           bnfpo,
           frgdt,
           badat,
           loekz,
           ernam,
           banfn
      from eban into table @lt_eban
      for all entries in @lt_dat
      where banfn = @lt_dat-banfn and bnfpo = @lt_dat-bnfpo .

    lt_dat = lt_data .
    delete lt_dat where lifnr is initial .
    select lifnr,
           name1,
           name2,
           land1
       from lfa1 into table @data(lt_lfa1)
      for all entries in @lt_dat
       where lifnr = @lt_dat-lifnr .

    "se obtienen los movimientos de
    select ebeln,
           ebelp,
           bwart,
           mblnr,
           lfbja,
           lfbnr,
           bpmng,
           insmk,
           mjahr,
           budat_mkpf,
           charg
       from mseg into table @data(lt_mseg)
      for all entries in @lt_data
      where ebeln = @lt_data-ebeln and ebelp = @lt_data-ebelp .

    if lt_mseg is not initial.
      select mblnr,
         mjahr,
         frbnr
     from mkpf into table @data(lt_mkpf)
    for all entries in @lt_mseg
    where mblnr = @lt_mseg-mblnr and mjahr = @lt_mseg-mjahr .
    endif.

    "se obtiene todos el historial de compras

    select ebeln,
           ebelp,
           lfbnr,
           lfgja,
           belnr,
           vgabe,
           gjahr
        from ekbe into table @data(lt_ekbe)
      for all entries in @lt_data
      where ebeln = @lt_data-ebeln and ebelp = @lt_data-ebelp .


    select ebeln,
           ebelp,
           kostl
      from ekkn into table @data(lt_ekkn)
    for all entries in @lt_data
    where ebeln = @lt_data-ebeln and ebelp = @lt_data-ebelp .
    if lt_ekkn is not initial.
      select distinct * from csks into table @data(lt_csks)
        for all entries in @lt_ekkn
        where kokrs = 'GMIF'
        and kostl = @lt_ekkn-kostl.
    endif.




