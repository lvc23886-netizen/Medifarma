*&---------------------------------------------------------------------*
*& Report ZGPPR_MIF_0013
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zgppr_mif_0013.
TABLES: stko, mast.

*----------------------------------------------------------------------
* Selección
*----------------------------------------------------------------------
PARAMETERS: p_spras TYPE spras DEFAULT sy-langu.

SELECT-OPTIONS:
  s_matnr FOR mast-matnr,
  s_werks FOR mast-werks,
  s_stlan FOR mast-stlan,
  s_stlal FOR stko-stlal.           .

*----------------------------------------------------------------------
* Tipos y tablas
*----------------------------------------------------------------------
TYPES: BEGIN OF ty_out,
         matnr TYPE matnr,
         werks TYPE werks_d,
         stlan TYPE stlan,     "Uso del BOM
         stlal TYPE stalt,     "Alternativa
         stlnr TYPE stnum,     "Número interno BOM
         spras TYPE spras,
         text  TYPE string,    "Texto concatenado
       END OF ty_out.

DATA: ti_out TYPE STANDARD TABLE OF ty_out .

FIELD-SYMBOLS <ft_outtab> TYPE ANY TABLE.

* Objeto de la clase CL_SALV_TABLE
DATA obj_alv_table TYPE REF TO cl_salv_table.

*----------------------------------------------------------------------
* Lógica principal
*----------------------------------------------------------------------
START-OF-SELECTION.

  SELECT *
  FROM mast
   INTO TABLE @DATA(lt_mast)
   WHERE matnr IN @s_matnr
     AND werks IN @s_werks
     AND stlan IN @s_stlan
     AND stlal IN @s_stlal.


  LOOP AT lt_mast ASSIGNING FIELD-SYMBOL(<fs_mast>).
    APPEND INITIAL LINE TO ti_out ASSIGNING FIELD-SYMBOL(<fs_out>).


    DATA(lv_text)  = VALUE string( ).
    DATA(lv_found) = abap_false.

    PERFORM read_bom_texts USING <fs_mast> p_spras
                           CHANGING lv_text lv_found.

    MOVE-CORRESPONDING <fs_mast> TO <fs_out>.

    <fs_out>-spras = p_spras.
    <fs_out>-text  = COND #( WHEN lv_found = abap_true THEN lv_text ELSE '' ) .

  ENDLOOP.

  IF sy-subrc EQ 0.
    ASSIGN ti_out TO <ft_outtab>.
  ENDIF.

*----------------------------------------------------------------------
* ALV
*----------------------------------------------------------------------
  TRY.
      cl_salv_table=>factory( IMPORTING r_salv_table = obj_alv_table
                              CHANGING t_table       = <ft_outtab> ).
      obj_alv_table->get_functions( )->set_all( abap_true ).
      obj_alv_table->get_columns( )->get_column( 'TEXT' )->set_long_text( 'Texto cabecera BOM' ).
      obj_alv_table->display( ).
    CATCH cx_salv_msg.
      LOOP AT ti_out ASSIGNING FIELD-SYMBOL(<s>).
        WRITE: / <s>-matnr, <s>-werks, <s>-stlan, <s>-stlal, <s>-stlnr, <s>-spras, 30(80) <s>-text.
      ENDLOOP.
  ENDTRY.

*----------------------------------------------------------------------
*
*----------------------------------------------------------------------
FORM read_bom_texts USING is_mast TYPE mast iv_spras
                    CHANGING cv_text  TYPE string
                             ev_found TYPE abap_bool.

  DATA: lt_lines TYPE STANDARD TABLE OF tline.

  DATA(lv_stlnr) = |{ is_mast-stlnr ALPHA = IN }|.

  DATA(lv_name) = CONV tdobname( |{ sy-mandt }M{ lv_stlnr }|  ).

*  lv_name = |{ sy-mandt }M{ lv_stlnr }| .

  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      id              = 'MZU'
      language        = p_spras
      name            = lv_name
      object          = 'BOM'        "Text object para cabecera de BOM
    TABLES
      lines           = lt_lines
    EXCEPTIONS
      id              = 1
      language        = 2
      name            = 3
      not_found       = 4
      object          = 5
      reference_check = 6
      OTHERS          = 7.

  IF sy-subrc = 0 AND lt_lines IS NOT INITIAL.
    LOOP AT lt_lines ASSIGNING FIELD-SYMBOL(<ls_line>).
      IF cv_text IS INITIAL.
        cv_text = <ls_line>-tdline.
      ELSE.
        CONCATENATE cv_text cl_abap_char_utilities=>cr_lf <ls_line>-tdline
          INTO cv_text.
      ENDIF.
    ENDLOOP.
    ev_found = abap_true.
  ENDIF.

ENDFORM.
