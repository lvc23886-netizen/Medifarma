FORM muestra_reporte .
  CLEAR: st_layout.
  st_layout-colwidth_optimize = 'X'.
  PERFORM f_fieldcat.
  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      is_layout     = st_layout
      it_fieldcat   = ti_fcat[]
*     i_screen_start_column = 20
*     i_screen_start_line   = 5
*     i_screen_end_column   = 120
*     i_screen_end_line     = 15
    TABLES
      t_outtab      = ti_alv[]
    EXCEPTIONS
      program_error = 1
      OTHERS        = 2.
ENDFORM. " MUESTRA_REPORTE
*&---------------------------------------------------------------------*
*&      Form  F_FIELDCAT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_fieldcat .
  DATA: vl_pos TYPE i.
  REFRESH ti_fcat[].
  CLEAR vl_pos.

  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'BUKRS'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = 'Sociedad'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'PRGRP'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = 'Grupo prod.'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'MAKTX2'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = 'Desc.Gr. prod.'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'MATNR'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-ref_fieldname = 'MATNR'.
  st_fcat-ref_tabname = 'MARA'.
  st_fcat-seltext_l  = 'Material'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'MAKTX'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = 'Desc. Material'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'BASME'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = 'U.M.'.
  APPEND st_fcat TO ti_fcat.
  CLEAR st_fcat.
  ADD 1 TO vl_pos.
  st_fcat-col_pos    = vl_pos.
  st_fcat-fieldname  = 'ANTEI'.
  st_fcat-tabname    = 'TI_ALV'.
  st_fcat-seltext_l  = '% Prop.'.
  st_fcat-ref_fieldname = 'ANTEI'.
  st_fcat-ref_tabname = 'PGAN'.
  APPEND st_fcat TO ti_fcat.

* bukrs TYPE s700e-bukrs,
*         prgrp TYPE s700e-prgrp,
*         matnr TYPE s700e-matnr,
*         maktx type makt-maktx,
*         basme TYPE s700e-basme,
*         antei TYPE s700e-antei,
ENDFORM. " F_FIELDCAT
*&---------------------------------------------------------------------*
*&      Form  calcula_dia
*&---------------------------------------------------------------------*
FORM calcula_dia USING i_dats    TYPE sy-datum
                       i_days    TYPE t5a4a-dlydy
                       i_months  TYPE t5a4a-dlymo
                       i_signum  TYPE c
                       i_years  TYPE t5a4a-dlyyr
                  CHANGING e_dats TYPE sy-datum.


  CALL FUNCTION 'RP_CALC_DATE_IN_INTERVAL'
    EXPORTING
      date      = i_dats
      days      = i_days
      months    = i_months
      signum    = i_signum
      years     = i_years
    IMPORTING
      calc_date = e_dats.
ENDFORM.
