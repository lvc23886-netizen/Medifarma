*&============================================================*
*& Report ZPPPR_CARGA_SOP                                      *
*&============================================================*
*& Descripción: Actualización Porcentaje Jerarquía Planifiación   *
*&                                                            *
*&     Fecha Creación  = 12.10.2025                           *
*&     Creador         = KUMO                                 *
*&     Empresa         = KUMO                                 *
*&                                                            *
*&============================================================*
*& Histórico de modificaciones                                *
*&============================================================*
*& @NNN  NNN = numeración de 000 a 999.                      *
*& Autor:                                                     *
*& Fecha:                                                     *
*& Descripción la Modificación:                               *
*&                                                            *
*&============================================================*
REPORT zpppr_act_jp.

*---------------------------------------------------------------------*
* Tablas internas y estructuras
*---------------------------------------------------------------------*
TYPES: BEGIN OF ty_prom,
         matnr TYPE s700-matnr,
         spmon TYPE s700-spmon,
         menge TYPE mseg-menge,
         cant TYPE i,
         porc TYPE mseg-menge,
       END OF ty_prom,
       BEGIN OF ty_matnr,
         matnr TYPE marc-matnr,
         werks TYPE marc-werks,
         dismm TYPE marc-dismm,
         dispo TYPE marc-dispo,
         END OF ty_matnr,
       BEGIN OF ty_alv,
         bukrs TYPE s700e-bukrs,
         prgrp TYPE s700e-prgrp,
         maktx2 TYPE makt-maktx,
         matnr TYPE s700e-matnr,
         maktx TYPE makt-maktx,
         basme TYPE s700e-basme,
         antei TYPE cha_class_view-sollwert,
         END OF ty_alv.

DATA: ti_alv    TYPE STANDARD TABLE OF ty_alv,
      st_fcat   TYPE slis_fieldcat_alv,
      ti_fcat   LIKE STANDARD TABLE OF st_fcat,
      st_layout TYPE slis_layout_alv,
      st_matnr  TYPE ty_matnr,
      ti_matnr  like STANDARD TABLE OF st_matnr,
      st_prom   TYPE ty_prom,
      ti_prom   LIKE STANDARD TABLE OF st_prom,
      ti_prom2  LIKE STANDARD TABLE OF st_prom,


      ti_s700   LIKE STANDARD TABLE OF s700,
      ti_pgan   LIKE STANDARD TABLE OF pgan,
      ti_s700e  LIKE STANDARD TABLE OF s700e.
DATA: gl_tabix TYPE sy-tabix.

*---------------------------------------------------------------------*
* Parámetros de selección
*---------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE text-t01.
PARAMETERS: p_mcinf TYPE rmcp7-mcinf DEFAULT 'S700',
            p_bukrs TYPE t001-bukrs DEFAULT '1000',
            p_monat TYPE monat DEFAULT '12'.
PARAMETERS: r_act RADIOBUTTON GROUP rb1 DEFAULT 'X',
            r_rep RADIOBUTTON GROUP rb1.
SELECTION-SCREEN END OF BLOCK b01.
*---------------------------------------------------------------------*
* Selection-screen
*---------------------------------------------------------------------*
AT SELECTION-SCREEN ON p_mcinf.
  IF p_mcinf NE 'S700'.
    MESSAGE e000(z001) WITH 'Estructura planif. sólo S700'.
  ENDIF.
*---------------------------------------------------------------------*
* Programa principal
*---------------------------------------------------------------------*
START-OF-SELECTION.
  PERFORM obtiene_datos.
  IF r_act EQ 'X'.
    PERFORM procesa_datos.
  ELSEIF r_rep EQ 'X'.
    PERFORM procesa_reporte.
    PERFORM muestra_reporte.
  ENDIF.

*&---------------------------------------------------------------------*
*&      Form  OBTIENE_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM obtiene_datos .
  DATA: lv_first TYPE d,
        lv_start TYPE d,
        lv_end   TYPE d.

  RANGES: r_spmon FOR s700-spmon,
          r_datum FOR sy-datum.

  CLEAR:r_spmon,r_datum,lv_first,lv_start,lv_end.
  REFRESH:r_spmon,r_datum.

****Calculo de fechas
  lv_first = sy-datum.
  lv_first+6(2) = '01'.

  PERFORM calcula_dia USING lv_first '00' p_monat '-' '00'
                      CHANGING lv_start.

  PERFORM calcula_dia USING lv_first '00' 1 '-' '00'
                      CHANGING lv_end.

  r_spmon[] = VALUE #( ( sign = 'I' option = 'BT' low = lv_start high = lv_end ) ).

  SELECT *  INTO TABLE ti_pgan
    FROM pgan
    WHERE gstru EQ p_mcinf.

  SELECT *  INTO TABLE ti_s700e
    FROM s700e
    WHERE bukrs EQ p_bukrs.

  SELECT * INTO TABLE ti_s700
  FROM s700
    WHERE vrsio EQ '000'
    AND spmon IN r_spmon
    AND bukrs EQ p_bukrs.


ENDFORM. " OBTIENE_DATOS
*&---------------------------------------------------------------------*
*&      Form  PROCESA_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM procesa_datos.
  DATA:l_menge TYPE mseg-menge,
       l_char1 TYPE qfltp-sollwert,
       l_porc  TYPE mseg-menge.

*Se obtiene cantidad
  REFRESH:ti_prom,ti_prom2.
  LOOP AT ti_s700 ASSIGNING FIELD-SYMBOL(<fs_s700>).
    CLEAR: st_prom.
    st_prom-matnr = <fs_s700>-matnr.
    st_prom-spmon = <fs_s700>-spmon.
    st_prom-menge = <fs_s700>-absat.
    IF st_prom-menge LT 0.
      CLEAR:st_prom-menge.
    ENDIF.
    COLLECT st_prom INTO ti_prom.
  ENDLOOP.

  REFRESH:ti_prom2.
  LOOP AT ti_prom INTO st_prom.
    CLEAR:st_prom-spmon.
    IF NOT st_prom-menge IS INITIAL.
      st_prom-cant = 1.
    ENDIF.
    COLLECT st_prom INTO ti_prom2.
  ENDLOOP.

  LOOP AT  ti_prom2 ASSIGNING FIELD-SYMBOL(<fs_prom2>).
    IF <fs_prom2>-cant GT 0.
      <fs_prom2>-menge = <fs_prom2>-menge / <fs_prom2>-cant.
    ELSE.
      CLEAR:<fs_prom2>-menge.
    ENDIF.
  ENDLOOP.

*Se obtiene los materiales y grupos de producto
  DATA(lt_s700e2)  = ti_s700e.
  DELETE lt_s700e2 WHERE werks NE space.
  DELETE lt_s700e2 WHERE matnr EQ space.

*Se limpian los porcentajes.
  LOOP AT lt_s700e2 ASSIGNING FIELD-SYMBOL(<fs_s700e2>).
    READ TABLE ti_s700e ASSIGNING FIELD-SYMBOL(<fs_s700e>) WITH KEY bukrs = <fs_s700e2>-bukrs
                                                                    prgrp = <fs_s700e2>-prgrp
                                                                    matnr = <fs_s700e2>-matnr
                                                                    werks = space.
    IF sy-subrc EQ 0.
      READ TABLE ti_pgan ASSIGNING FIELD-SYMBOL(<fs_pgan>) WITH KEY plobu = <fs_s700e>-plobj.
      IF sy-subrc EQ 0.
        CLEAR:<fs_pgan>-antei.
      ENDIF.
    ENDIF.
  ENDLOOP.

  DATA(lt_s700egr) = ti_s700e[].
  DELETE lt_s700egr WHERE prgrp EQ space.
  DELETE lt_s700egr WHERE matnr NE space.
  SORT lt_s700egr BY bukrs prgrp.
  SORT lt_s700e2 BY bukrs prgrp.

  LOOP AT lt_s700egr ASSIGNING FIELD-SYMBOL(<fs_s700egr>).
    CLEAR: l_menge.
*Se obtiene el valor total de los materiales que conforman el grupo de productos
    LOOP AT lt_s700e2 ASSIGNING <fs_s700e2> WHERE bukrs EQ <fs_s700egr>-bukrs
                                              AND prgrp EQ <fs_s700egr>-prgrp.
      READ TABLE ti_prom2 ASSIGNING <fs_prom2> WITH KEY matnr = <fs_s700e2>-matnr.
      IF sy-subrc EQ 0.
        ADD <fs_prom2>-menge TO l_menge.
      ENDIF.
    ENDLOOP.


    CLEAR:l_porc.
    IF NOT l_menge IS INITIAL.
      LOOP AT lt_s700e2 ASSIGNING <fs_s700e2> WHERE bukrs EQ <fs_s700egr>-bukrs
                                                AND prgrp EQ <fs_s700egr>-prgrp.
        CLEAR:l_porc.
        READ TABLE ti_prom2 ASSIGNING <fs_prom2> WITH KEY matnr = <fs_s700e2>-matnr.
        IF sy-subrc EQ 0.
          l_porc = ( <fs_prom2>-menge ) / l_menge .
          READ TABLE ti_s700e ASSIGNING <fs_s700e> WITH KEY bukrs = <fs_s700egr>-bukrs
                                                            prgrp = <fs_s700egr>-prgrp
                                                            matnr = <fs_s700e2>-matnr
                                                            werks = space.
          IF sy-subrc EQ 0.
            READ TABLE ti_pgan ASSIGNING <fs_pgan> WITH KEY plobu = <fs_s700e>-plobj.
            IF sy-subrc EQ 0.
              CLEAR:<fs_pgan>-antei.
              IF l_porc LT 0.
                CLEAR:l_porc.
                l_char1 = l_porc.
              ELSE.
                l_char1 = l_porc.
              ENDIF.

              CALL FUNCTION 'QSS0_CHAR_FLTP_CONVERSION'
                EXPORTING
                  i_character_string = l_char1
                  i_number_of_digits = 3
                IMPORTING
                  e_fltp_value       = <fs_pgan>-antei.
            ENDIF.
          ENDIF.
        ELSE.
          READ TABLE ti_s700e ASSIGNING <fs_s700e> WITH KEY bukrs = <fs_s700egr>-bukrs
                                                            prgrp = <fs_s700egr>-prgrp
                                                            matnr = <fs_s700e2>-matnr
                                                            werks = space.
          IF sy-subrc EQ 0.
            READ TABLE ti_pgan ASSIGNING <fs_pgan> WITH KEY plobu = <fs_s700e>-plobj.
            IF sy-subrc EQ 0.
              CLEAR:<fs_pgan>-antei.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ELSE.
      LOOP AT lt_s700e2 ASSIGNING <fs_s700e2>  WHERE bukrs EQ <fs_s700egr>-bukrs
                                                 AND prgrp EQ <fs_s700egr>-prgrp.
        READ TABLE ti_s700e ASSIGNING <fs_s700e> WITH KEY bukrs = <fs_s700egr>-bukrs
                                                          prgrp = <fs_s700egr>-prgrp
                                                          matnr = <fs_s700e2>-matnr
                                                          werks = space.
        IF sy-subrc EQ 0.
          READ TABLE ti_pgan ASSIGNING <fs_pgan> WITH KEY plobu = <fs_s700e>-plobj.
          IF sy-subrc EQ 0.
            CLEAR:<fs_pgan>-antei.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDLOOP.

  CALL FUNCTION 'PGAN_UPDATE'
    EXPORTING
      i_vbschr = 'U'
    TABLES
      e_pgan   = ti_pgan.
  MESSAGE i000(z001) WITH 'Se actualizaron los porcentajes.'.
ENDFORM. " PROCESA_DATOS
*&---------------------------------------------------------------------*
*&      Form  PROCESA_REPORTE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM procesa_reporte .
*Se obtiene los materiales y grupos de producto
  REFRESH:ti_alv.
  DATA(lt_s700e2) = ti_s700e[].
  DATA(lt_s700egr) = ti_s700e[].
  DELETE lt_s700e2 WHERE werks NE space.
  DELETE lt_s700e2 WHERE matnr EQ space.

  LOOP AT lt_s700e2 ASSIGNING FIELD-SYMBOL(<fs_s700e2>).
    CLEAR: st_matnr.
    st_matnr-matnr = <fs_s700e2>-matnr.
    COLLECT st_matnr INTO ti_matnr.
    CLEAR: st_matnr.
    st_matnr-matnr = <fs_s700e2>-prgrp.
    COLLECT st_matnr INTO ti_matnr.

   APPEND INITIAL LINE TO ti_alv ASSIGNING FIELD-SYMBOL(<fs_alv>).
   READ TABLE ti_s700e ASSIGNING FIELD-SYMBOL(<fs_s700e>) WITH KEY bukrs = <fs_s700e2>-bukrs
                                                                    prgrp = <fs_s700e2>-prgrp
                                                                    matnr = <fs_s700e2>-matnr
                                                                    werks = space.
    IF sy-subrc EQ 0.
      MOVE-CORRESPONDING <fs_s700e> TO <fs_alv>.
      READ TABLE ti_pgan ASSIGNING FIELD-SYMBOL(<fs_pgan>) WITH KEY plobu = <fs_s700e>-plobj.
      IF sy-subrc EQ 0.
        CALL FUNCTION 'QSS0_FLTP_TO_CHAR_CONVERSION'
          EXPORTING
            i_number_of_digits = 3
            i_fltp_value       = <fs_pgan>-antei
          IMPORTING
            e_char_field       = <fs_alv>-antei.
      ENDIF.
    ENDIF.

  ENDLOOP.

*Se obtiene datos adicionales.
  IF NOT ti_matnr IS INITIAL.
    SELECT matnr,maktx INTO TABLE @DATA(lt_maktx)
      FROM makt FOR ALL ENTRIES IN @ti_matnr
      WHERE matnr EQ @ti_matnr-matnr
      AND   spras EQ @sy-langu.
  ENDIF.

  LOOP AT ti_alv ASSIGNING <fs_alv>.
    <fs_alv>-antei = <fs_alv>-antei * 100.
    READ TABLE lt_maktx ASSIGNING FIELD-SYMBOL(<fs_maktx>) WITH KEY matnr = <fs_alv>-matnr.
    IF sy-subrc EQ 0.
      <fs_alv>-maktx = <fs_maktx>-maktx.
    ENDIF.
    READ TABLE lt_maktx ASSIGNING <fs_maktx> WITH KEY matnr = <fs_alv>-prgrp.
    IF sy-subrc EQ 0.
      <fs_alv>-maktx2 = <fs_maktx>-maktx.
    ENDIF.
  ENDLOOP.
ENDFORM. " PROCESA_REPORTE
*&---------------------------------------------------------------------*
*&      Form  MUESTRA_REPORTE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
