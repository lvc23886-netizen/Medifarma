*& Report  ZPP_ACT_PROP_SOP_CELIMA
*&
*&---------------------------------------------------------------------*
*&
*&
*&---------------------------------------------------------------------*

REPORT zpp_act_porc_sop_celima.
*---------------------------------------------------------------------*
* Tablas internas y estructuras
*---------------------------------------------------------------------*
TYPES: BEGIN OF ty_pbim,
        matnr TYPE pbim-matnr,
        werks TYPE pbim-werks,
        bedae TYPE pbim-bedae,
        versb TYPE pbim-versb,
        bdzei TYPE pbim-bdzei,
        pdatu TYPE pbed-pdatu,
        meins TYPE pbed-meins,
        plnmg TYPE pbed-plnmg,
        entmg TYPE pbed-entmg,
       END OF ty_pbim,
       BEGIN OF ty_prom,
         matnr TYPE s700-matnr,
         spmon TYPE s700-spmon,
         menge TYPE mseg-menge,
         cant TYPE i,
         porc TYPE mseg-menge,
       END OF ty_prom,
       BEGIN OF ty_maktx,
         matnr TYPE marc-matnr,
         maktx TYPE makt-maktx,
*         dispo TYPE marc-dispo,
         END OF ty_maktx,
       BEGIN OF ty_matnr,
         matnr TYPE marc-matnr,
         werks TYPE marc-werks,
         dismm TYPE marc-dismm,
         dispo TYPE marc-dispo,
         END OF ty_matnr,
       BEGIN OF ty_alv,
         bukrs TYPE s700e-bukrs,
         prgrp TYPE s700e-prgrp,
         maktx2 TYPE makt-maktx,
         matnr TYPE s700e-matnr,
         maktx TYPE makt-maktx,
         basme TYPE s700e-basme,
         antei TYPE cha_class_view-sollwert,
         END OF ty_alv.

DATA: st_alv TYPE ty_alv,
      ti_alv LIKE STANDARD TABLE OF st_alv,
      st_fcat   TYPE slis_fieldcat_alv,
      ti_fcat   LIKE STANDARD TABLE OF st_fcat,
      st_layout TYPE slis_layout_alv,
      st_pbim TYPE ty_pbim,
      ti_pbim LIKE STANDARD TABLE OF st_pbim,
      st_maktx TYPE ty_maktx,
      ti_maktx LIKE STANDARD TABLE OF st_maktx,
      st_matnr TYPE ty_matnr,
      ti_matnr LIKE STANDARD TABLE OF st_matnr,
      ti_matnrnd LIKE STANDARD TABLE OF st_matnr,
      ti_matnr2 LIKE STANDARD TABLE OF st_matnr,
      st_prom TYPE ty_prom,
      ti_prom LIKE STANDARD TABLE OF st_prom,
      st_prom2 TYPE ty_prom,
      ti_prom2 LIKE STANDARD TABLE OF st_prom2,
      st_s700 TYPE s700,
      ti_s700 LIKE STANDARD TABLE OF st_s700,
      st_pgan TYPE pgan,
      ti_pgan LIKE STANDARD TABLE OF st_pgan,
      st_s700e TYPE s700e,
      ti_s700e LIKE STANDARD TABLE OF st_s700e,
      st_s700e2 TYPE s700e,
      ti_s700e2 LIKE STANDARD TABLE OF st_s700e,
      st_s700egr TYPE s700e,
      ti_s700egr LIKE STANDARD TABLE OF st_s700e..
DATA: gl_tabix TYPE sy-tabix.
*---------------------------------------------------------------------*
* Parámetros de selección
*---------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE text-t01.
PARAMETERS: p_mcinf TYPE rmcp7-mcinf DEFAULT 'S700',
            p_bukrs TYPE t001-bukrs DEFAULT '1000'.
PARAMETERS: r_act RADIOBUTTON GROUP rb1 DEFAULT 'X',
            r_rep RADIOBUTTON GROUP rb1.
SELECTION-SCREEN END OF BLOCK b01.
*---------------------------------------------------------------------*
* Selection-screen
*---------------------------------------------------------------------*
AT SELECTION-SCREEN ON p_mcinf.
  IF p_mcinf NE 'S700'.
    MESSAGE e000(z001) WITH 'Estructura planif. sólo S700'.
  ENDIF.
*---------------------------------------------------------------------*
* Programa principal
*---------------------------------------------------------------------*
START-OF-SELECTION.
  PERFORM obtiene_datos.
  IF r_act EQ 'X'.
    PERFORM procesa_datos.
  ELSEIF r_rep EQ 'X'.
    PERFORM procesa_reporte.
    PERFORM muestra_reporte.
  ENDIF.

*&---------------------------------------------------------------------*
*&      Form  OBTIENE_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM obtiene_datos .
  RANGES: r_spmon FOR s700-spmon,
          r_datum FOR sy-datum.
  CLEAR:r_spmon,r_datum.
  REFRESH:r_spmon,r_datum,ti_s700e,ti_s700,ti_matnr2.
*Se obtienen los 3 meses anteriores.
  r_datum-sign   = 'I'.
  r_datum-option = 'BT'.
  r_datum-low = sy-datum.
  r_datum-low+6(2) = '01'.
  CALL FUNCTION 'HR_HCP_GET_LAST_DAY_OF_MONTH'
    EXPORTING
      im_date              = r_datum-low
    IMPORTING
*     EX_DATE_IS_MONTHEND  =
      ex_last_day_of_month = r_datum-high.
  APPEND r_datum.
*  r_datum-high = sy-datum.
  IF sy-datum+4(2) GT '03'.
    CLEAR:r_spmon.
    r_spmon-sign = 'I'.
    r_spmon-option = 'BT'.
    r_spmon-low+0(4) = sy-datum+0(4).
    r_spmon-low+4(2) = sy-datum+4(2) - 3.
    r_spmon-high+0(4) = sy-datum+0(4).
    r_spmon-high+4(2) = sy-datum+4(2) - 1.
    APPEND r_spmon.
  ELSE.
    CLEAR:r_spmon.
    r_spmon-sign = 'I'.
    r_spmon-option = 'BT'.
    r_spmon-low+0(4) = sy-datum+0(4) - 1.
*    r_spmon-high+0(4) = sy-datum+0(4) - 1.
    CASE sy-datum+4(2).
      WHEN '01'.
        r_spmon-low+4(2) = '10'.
        r_spmon-high+4(2) = '12'.
        r_spmon-high+0(4) = sy-datum+0(4) - 1.
      WHEN '02'.
        r_spmon-low+4(2) = '11'.
        r_spmon-high+4(2) = '01'.
        r_spmon-high+0(4) = sy-datum+0(4).
      WHEN '03'.
        r_spmon-low+4(2) = '12'.
        r_spmon-high+4(2) = '02'.
        r_spmon-high+0(4) = sy-datum+0(4).
    ENDCASE.

    APPEND r_spmon.
  ENDIF.

  REFRESH: ti_pgan.
  SELECT *  INTO TABLE ti_pgan
    FROM pgan
    WHERE gstru EQ p_mcinf.

  SELECT *  INTO TABLE ti_s700e
    FROM s700e
    WHERE bukrs EQ p_bukrs.
  SELECT * INTO TABLE ti_s700
  FROM s700
    WHERE vrsio EQ '000'
    AND spmon IN r_spmon
    AND bukrs EQ p_bukrs.
  REFRESH:ti_s700e2,ti_pbim.
  ti_s700e2[] = ti_s700e[].
  DELETE ti_s700e2 WHERE werks EQ space.
  REFRESH:ti_matnr.
  IF NOT ti_s700e2 IS INITIAL.
*Se obtienen las necesidades del mes.
    SELECT a~matnr a~werks a~bedae a~versb a~bdzei b~pdatu b~meins b~plnmg b~entmg
    INTO TABLE ti_pbim
    FROM pbim AS a INNER JOIN pbed AS b
      ON a~bdzei EQ b~bdzei
    FOR ALL ENTRIES IN ti_s700e2
      WHERE matnr EQ ti_s700e2-matnr
        AND werks EQ ti_s700e2-werks
        AND pdatu IN r_datum.

    SELECT matnr werks dismm dispo
      INTO TABLE ti_matnr
      FROM marc FOR ALL ENTRIES IN ti_s700e2
      WHERE matnr EQ ti_s700e2-matnr
      AND werks EQ ti_s700e2-werks.
    REFRESH:ti_matnrnd.
    ti_matnrnd[] = ti_matnr[].
*    DELETE ti_matnrnd WHERE dispo EQ 'ND'.
    DELETE ti_matnrnd WHERE dismm EQ 'ND'.
  ENDIF.

ENDFORM. " OBTIENE_DATOS
*&---------------------------------------------------------------------*
*&      Form  PROCESA_DATOS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM procesa_datos.
  DATA:l_menge TYPE mseg-menge,
        l_char1 TYPE qfltp-sollwert,
        l_porc TYPE mseg-menge.
*Se obtiene cantidad
  REFRESH:ti_prom,ti_prom2.
  LOOP AT ti_s700 INTO st_s700.
    CLEAR: st_prom.
    st_prom-matnr = st_s700-matnr.
    st_prom-spmon = st_s700-spmon.
    st_prom-menge = st_s700-absat.
    IF st_prom-menge lt 0.
      clear:st_prom-menge.
    ENDIF.
    COLLECT st_prom INTO ti_prom.
  ENDLOOP.
*Se calcula la cantidad de demanda por material
  LOOP AT ti_pbim INTO st_pbim.
    CLEAR: st_prom.
    st_prom-matnr = st_pbim-matnr.
    st_prom-spmon = st_pbim-pdatu+0(6).
    st_prom-menge = st_pbim-plnmg + st_pbim-entmg.
    COLLECT st_prom INTO ti_prom.
  ENDLOOP.
  REFRESH:ti_prom2.
  LOOP AT ti_prom INTO st_prom.
    CLEAR:st_prom-spmon.
    IF NOT st_prom-menge IS INITIAL.
      st_prom-cant = 1.
    ENDIF.
    COLLECT st_prom INTO ti_prom2.
  ENDLOOP.

  LOOP AT  ti_prom2 INTO st_prom2.
    gl_tabix = sy-tabix.
    IF st_prom-cant GT 0.
      st_prom2-menge = st_prom2-menge / st_prom2-cant.
    ELSE.
      CLEAR:st_prom2-menge.
    ENDIF.
    MODIFY ti_prom2 FROM st_prom2 INDEX gl_tabix.
  ENDLOOP.
*Se obtiene los materiales y grupos de producto
  REFRESH:ti_s700e2,ti_s700egr.
  ti_s700e2[] = ti_s700e[].
  ti_s700egr[] = ti_s700e[].
  DELETE ti_s700e2 WHERE werks NE space.
  DELETE ti_s700e2 WHERE matnr EQ space.
*Se limpian los porcentajes.
  LOOP AT ti_s700e2 INTO st_s700e2.
    READ TABLE ti_s700e INTO st_s700e WITH KEY bukrs = st_s700e2-bukrs
                                                       prgrp = st_s700e2-prgrp
                                                       matnr = st_s700e2-matnr
                                                       werks = space.
    IF sy-subrc EQ 0.
      READ TABLE ti_pgan INTO st_pgan WITH KEY plobu = st_s700e-plobj.
      IF sy-subrc EQ 0.
        gl_tabix = sy-tabix.
        CLEAR:st_pgan-antei.
*              st_pgan-antei = l_porc.
        MODIFY ti_pgan FROM st_pgan INDEX gl_tabix.
      ENDIF.
    ENDIF.
  ENDLOOP.
  DELETE ti_s700egr WHERE prgrp EQ space.
  DELETE ti_s700egr WHERE matnr NE space.
  SORT ti_s700e2 BY bukrs prgrp.
  SORT ti_s700egr BY bukrs prgrp.
  LOOP AT ti_s700egr INTO st_s700egr.
    CLEAR: l_menge.
*Se obtiene el valor total de los materiales que conforman el grupo de productos
    LOOP AT ti_s700e2 INTO st_s700e2 WHERE bukrs EQ st_s700egr-bukrs
                                       AND prgrp EQ st_s700egr-prgrp.
*Se valida que el material no tenga ND en todos los centros.
      READ TABLE ti_matnrnd INTO st_matnr WITH KEY matnr = st_s700e2-matnr.
      IF sy-subrc EQ 0.
        READ TABLE ti_prom2 INTO st_prom2 WITH KEY matnr = st_s700e2-matnr.
        IF sy-subrc EQ 0.
          ADD st_prom2-menge TO l_menge.
        ENDIF.
      ENDIF.
    ENDLOOP.
    CLEAR:l_porc.
    IF NOT l_menge IS INITIAL.
      LOOP AT ti_s700e2 INTO st_s700e2 WHERE bukrs EQ st_s700egr-bukrs
                                         AND prgrp EQ st_s700egr-prgrp.
        CLEAR:l_porc.
*Se valida que el material no tenga ND en todos los centros.
        READ TABLE ti_matnrnd INTO st_matnr WITH KEY matnr = st_s700e2-matnr.
        IF sy-subrc EQ 0.
          READ TABLE ti_prom2 INTO st_prom2 WITH KEY matnr = st_s700e2-matnr.
          IF sy-subrc EQ 0.
            l_porc = ( st_prom2-menge ) / l_menge .
            READ TABLE ti_s700e INTO st_s700e WITH KEY bukrs = st_s700egr-bukrs
                                                       prgrp = st_s700egr-prgrp
                                                       matnr = st_s700e2-matnr
                                                       werks = space.
            IF sy-subrc EQ 0.
              READ TABLE ti_pgan INTO st_pgan WITH KEY plobu = st_s700e-plobj.
              IF sy-subrc EQ 0.
                gl_tabix = sy-tabix.
                CLEAR:st_pgan-antei.
                IF l_porc lT 0.
                  CLEAR:l_porc.
                  l_char1 = l_porc.
                ELSE.
                  l_char1 = l_porc.
                ENDIF.

                CALL FUNCTION 'QSS0_CHAR_FLTP_CONVERSION'
                  EXPORTING
*                   I_CHAR_FIELD_NAME        = ' '
                    i_character_string       = l_char1
                    i_number_of_digits       = 3
                  IMPORTING
*                   E_VALUE_NOT_INITIAL_FLAG =
                    e_fltp_value             = st_pgan-antei.
                MODIFY ti_pgan FROM st_pgan INDEX gl_tabix.
              ENDIF.
            ENDIF.
          ELSE.
            READ TABLE ti_s700e INTO st_s700e WITH KEY bukrs = st_s700egr-bukrs
                                                   prgrp = st_s700egr-prgrp
                                                   matnr = st_s700e2-matnr
                                                   werks = space.
            IF sy-subrc EQ 0.
              READ TABLE ti_pgan INTO st_pgan WITH KEY plobu = st_s700e-plobj.
              IF sy-subrc EQ 0.
                gl_tabix = sy-tabix.
                CLEAR:st_pgan-antei.
*              st_pgan-antei = l_porc.
                MODIFY ti_pgan FROM st_pgan INDEX gl_tabix.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ELSE.
      LOOP AT ti_s700e2 INTO st_s700e2 WHERE bukrs EQ st_s700egr-bukrs
                                       AND prgrp EQ st_s700egr-prgrp.
        READ TABLE ti_s700e INTO st_s700e WITH KEY bukrs = st_s700egr-bukrs
                                                   prgrp = st_s700egr-prgrp
                                                   matnr = st_s700e2-matnr
                                                   werks = space.
        IF sy-subrc EQ 0.
          READ TABLE ti_pgan INTO st_pgan WITH KEY plobu = st_s700e-plobj.
          IF sy-subrc EQ 0.
            gl_tabix = sy-tabix.
            CLEAR:st_pgan-antei.
*              st_pgan-antei = l_porc.
            MODIFY ti_pgan FROM st_pgan INDEX gl_tabix.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDLOOP.
  CALL FUNCTION 'PGAN_UPDATE'
    EXPORTING
      i_vbschr = 'U'
    TABLES
      e_pgan   = ti_pgan.
  MESSAGE i000(z001) WITH 'Se actualizaron los porcentajes.'.
ENDFORM. " PROCESA_DATOS
*&---------------------------------------------------------------------*
*&      Form  PROCESA_REPORTE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM procesa_reporte .
  FIELD-SYMBOLS <fs_alv> TYPE ty_alv.
*Se obtiene los materiales y grupos de producto
  REFRESH:ti_s700e2,ti_s700egr,ti_alv.
  ti_s700e2[] = ti_s700e[].
  ti_s700egr[] = ti_s700e[].
  DELETE ti_s700e2 WHERE werks NE space.
  DELETE ti_s700e2 WHERE matnr EQ space.
  LOOP AT ti_s700e2 INTO st_s700e2.
    CLEAR: st_matnr.
    st_matnr-matnr = st_s700e2-matnr.
    COLLECT st_matnr INTO ti_matnr2.
    CLEAR: st_matnr.
    st_matnr-matnr = st_s700e2-prgrp.
    COLLECT st_matnr INTO ti_matnr2.
    CLEAR: st_alv.
    READ TABLE ti_s700e INTO st_s700e WITH KEY bukrs = st_s700e2-bukrs
                                                       prgrp = st_s700e2-prgrp
                                                       matnr = st_s700e2-matnr
                                                       werks = space.
    IF sy-subrc EQ 0.
      MOVE-CORRESPONDING st_s700e TO st_alv.
      READ TABLE ti_pgan INTO st_pgan WITH KEY plobu = st_s700e-plobj.
      IF sy-subrc EQ 0.
        CALL FUNCTION 'QSS0_FLTP_TO_CHAR_CONVERSION'
          EXPORTING
            i_number_of_digits       = 3
            i_fltp_value             = st_pgan-antei
*           I_VALUE_NOT_INITIAL_FLAG = 'X'
*           I_SCREEN_FIELDLENGTH     = 16
          IMPORTING
            e_char_field             = st_alv-antei.

      ENDIF.
    ENDIF.
    APPEND st_alv TO ti_alv.
  ENDLOOP.
*Se obtiene datos adicionales.
  REFRESH:ti_maktx.
  IF NOT ti_matnr2 IS INITIAL.
    SELECT matnr maktx INTO TABLE ti_maktx
      FROM makt FOR ALL ENTRIES IN ti_matnr2
      WHERE matnr EQ ti_matnr2-matnr
      AND spras EQ sy-langu.
  ENDIF.
  LOOP AT ti_alv ASSIGNING <fs_alv>.
    <fs_alv>-antei = <fs_alv>-antei * 100.
    READ TABLE ti_maktx INTO st_maktx WITH KEY matnr = <fs_alv>-matnr.
    IF sy-subrc EQ 0.
      <fs_alv>-maktx = st_maktx-maktx.
    ENDIF.
    READ TABLE ti_maktx INTO st_maktx WITH KEY matnr = <fs_alv>-prgrp.
    IF sy-subrc EQ 0.
      <fs_alv>-maktx2 = st_maktx-maktx.
    ENDIF.
  ENDLOOP.
ENDFORM. " PROCESA_REPORTE
