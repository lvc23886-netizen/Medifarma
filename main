*&---------------------------------------------------------------------*
*& Form f_obtener_datos
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM f_obtener_datos .

  SELECT matnr maktx maktg
    INTO TABLE gdt_makt
    FROM makt
    FOR ALL ENTRIES IN gdt_excel
    WHERE spras EQ sy-langu
      AND matnr EQ gdt_excel-matnr.

  SELECT lifnr name1 name2 INTO TABLE gdt_lfa1
    FROM lfa1
    FOR ALL ENTRIES IN gdt_excel
    WHERE lifnr EQ gdt_excel-flief.

  SELECT matnr meins INTO TABLE gdt_mara
    FROM mara
    FOR ALL ENTRIES IN gdt_excel
    WHERE matnr EQ gdt_excel-matnr.

  SELECT * INTO TABLE gdt_tka02
    FROM tka02
    WHERE bukrs EQ p_bukrs.
  IF sy-subrc EQ 0.
    SELECT * INTO TABLE gdt_cskt
      FROM cskt
      FOR ALL ENTRIES IN gdt_tka02
      WHERE kokrs EQ gdt_tka02-kokrs.
  ENDIF.

  SELECT * INTO TABLE gdt_prps
    FROM prps
    FOR ALL ENTRIES IN gdt_excel
    WHERE posid EQ gdt_excel-imputacion(24).

  SELECT * INTO TABLE gdt_aufk
    FROM aufk
    FOR ALL ENTRIES IN gdt_excel
    WHERE aufnr EQ gdt_excel-imputacion(12).

  SELECT * INTO TABLE gdt_const
    FROM ztconstantes
    WHERE modulo   EQ 'MM'
      AND programa EQ sy-repid.
  LOOP AT gdt_const ASSIGNING FIELD-SYMBOL(<fs_const>).
    CASE <fs_const>-campo.
      WHEN 'BSART'.
        APPEND INITIAL LINE TO gr_bsart ASSIGNING FIELD-SYMBOL(<fs_bsart>).
        <fs_bsart>-sign = <fs_const>-signo. <fs_bsart>-option = <fs_const>-opcion.
        <fs_bsart>-low  = <fs_const>-valor_low.
      WHEN OTHERS.
    ENDCASE.
  ENDLOOP.

  SELECT * INTO TABLE gdt_t024e
    FROM t024e
    WHERE bukrs EQ p_bukrs.

  SELECT * INTO TABLE gdt_tcurc
    FROM tcurc.

  SELECT * INTO TABLE gdt_t001w
    FROM t001w
    FOR ALL ENTRIES IN gdt_excel
    WHERE werks EQ gdt_excel-werks.

  SELECT * INTO TABLE gdt_zmm_afnam
    FROM zmm_afnam
    FOR ALL ENTRIES IN gdt_excel
    WHERE bukrs EQ p_bukrs
      AND afnam EQ gdt_excel-afnam.

  SELECT * INTO TABLE gdt_marc
    FROM marc
    FOR ALL ENTRIES IN gdt_excel
    WHERE matnr EQ gdt_excel-matnr
      AND werks EQ gdt_excel-werks.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form f_log_errores
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> P_
*&      --> TEXT_E00
*&      <-- <FS_EXCEL>_LOG_PROCES
*&---------------------------------------------------------------------*
FORM f_log_errores  USING pi_icon
                          pi_text
                    CHANGING po_log_proces.

  IF po_log_proces IS INITIAL.
    po_log_proces = pi_text.
  ELSE.
    CONCATENATE po_log_proces pi_text INTO po_log_proces
    SEPARATED BY ','.
  ENDIF.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form f_generar_solped
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM f_generar_solped .
  REFRESH:gdt_pritem,gdt_pritemx,gdt_pritemtext,gdt_praccount,gdt_praccountx.
  CLEAR:gwa_prheader,gwa_prheaderx.

  DATA ldt_split TYPE TABLE OF string.
  DATA lr_split    TYPE REF TO string.

  LOOP AT gdt_excel ASSIGNING FIELD-SYMBOL(<fs_excel>).
    AT NEW bnfpo.
      CLEAR gv_pos.
    ENDAT.

    IF <fs_excel>-tipo EQ 'P'.
      gwa_prheader-pr_type = <fs_excel>-bsart.
      gwa_prheaderx-pr_type = abap_true.

      APPEND INITIAL LINE TO gdt_pritem ASSIGNING FIELD-SYMBOL(<fs_pritem>).
      <fs_pritem>-preq_item   = <fs_excel>-bnfpo.
      <fs_pritem>-pur_group   = <fs_excel>-ekgrp.
      <fs_pritem>-preq_name   = <fs_excel>-afnam.
      <fs_pritem>-material    = <fs_excel>-matnr.
      <fs_pritem>-plant       = <fs_excel>-werks.
      <fs_pritem>-quantity    = <fs_excel>-menge.
      <fs_pritem>-preq_date   = <fs_excel>-badat.
      <fs_pritem>-preq_price  = <fs_excel>-preis.
      <fs_pritem>-acctasscat  = <fs_excel>-knttp.
      <fs_pritem>-purch_org   = <fs_excel>-ekorg.
      <fs_pritem>-producttype = '2'.
      <fs_pritem>-startdate   = <fs_excel>-startdate.
      <fs_pritem>-enddate     = <fs_excel>-enddate.
      <fs_pritem>-unit        = <fs_excel>-meins.
      <fs_pritem>-des_vendor  = <fs_excel>-flief.
      <fs_pritem>-po_unit     = <fs_excel>-bmein.
      IF <fs_excel>-vrtkz EQ 0.
      ELSE.
        <fs_pritem>-distrib     = <fs_excel>-vrtkz.
        <fs_pritem>-part_inv = '2'.
      ENDIF.

      APPEND INITIAL LINE TO gdt_pritemx ASSIGNING FIELD-SYMBOL(<fs_pritemx>).
      <fs_pritemx>-preq_item = <fs_excel>-bnfpo.
      <fs_pritemx>-pur_group = <fs_pritemx>-preq_name = <fs_pritemx>-material    =
      <fs_pritemx>-plant = <fs_pritemx>-quantity = <fs_pritemx>-preq_date        =
      <fs_pritemx>-preq_price = <fs_pritemx>-acctasscat = <fs_pritemx>-purch_org =
      <fs_pritemx>-producttype = <fs_pritemx>-startdate = <fs_pritemx>-enddate   =
      <fs_pritemx>-unit = <fs_pritemx>-des_vendor = <fs_pritemx>-po_unit         =
      <fs_pritemx>-distrib = abap_true.

      REFRESH ldt_split.
      SPLIT <fs_excel>-texto_pos AT '&' INTO TABLE ldt_split.

      LOOP AT ldt_split REFERENCE INTO lr_split.
        APPEND INITIAL LINE TO gdt_pritemtext ASSIGNING FIELD-SYMBOL(<fs_pritemtext>).
        <fs_pritemtext>-preq_item = <fs_excel>-bnfpo.
        <fs_pritemtext>-text_id = 'B01'.
        <fs_pritemtext>-text_line = lr_split->*. "<fs_excel>-texto_pos(132).
        ADD 1 TO gv_text_form.
        <fs_pritemtext>-text_form = gv_text_form.
      ENDLOOP.


*      APPEND INITIAL LINE TO gdt_pritemtext ASSIGNING <fs_pritemtext>.
*      <fs_pritemtext>-preq_item = <fs_excel>-bnfpo.
*      <fs_pritemtext>-text_id = 'B01'.
*      <fs_pritemtext>-text_line = <fs_excel>-texto_pos+132(88).
*      ADD 1 TO gv_text_form.
*      <fs_pritemtext>-text_form = gv_text_form.

*      APPEND INITIAL LINE TO gdt_pritemtext ASSIGNING <fs_pritemtext>.
*      <fs_pritemtext>-preq_item = <fs_excel>-bnfpo.
*      <fs_pritemtext>-text_id = 'B01'.
*      <fs_pritemtext>-text_line = <fs_excel>-texto_pos+264(132).
*      ADD 1 TO gv_text_form.
*      <fs_pritemtext>-text_form = gv_text_form.

      DELETE gdt_pritemtext WHERE text_line EQ space.
    ELSE.

      APPEND INITIAL LINE TO gdt_praccountx ASSIGNING FIELD-SYMBOL(<fs_praccountx>).
      <fs_praccountx>-preq_item = <fs_excel>-bnfpo.

      ADD 1 TO gv_pos.
      CASE <fs_excel>-vrtkz_.
        WHEN 1 OR 0.
          APPEND INITIAL LINE TO gdt_praccount ASSIGNING FIELD-SYMBOL(<fs_praccount>).
          <fs_praccount>-preq_item = <fs_excel>-bnfpo.
          <fs_praccount>-serial_no = <fs_praccountx>-serial_no = gv_pos.
          <fs_praccount>-quantity  = <fs_excel>-dist_cant.
          <fs_praccountx>-quantity = abap_true.
        WHEN 2.
          APPEND INITIAL LINE TO gdt_praccount ASSIGNING <fs_praccount>.
          <fs_praccount>-preq_item  = <fs_excel>-bnfpo.
          <fs_praccount>-serial_no = <fs_praccountx>-serial_no = gv_pos.
          <fs_praccount>-distr_perc = <fs_excel>-vproz.
          <fs_praccountx>-distr_perc = abap_true.
      ENDCASE.

      IF <fs_excel>-knttp_ EQ 'K'.
        <fs_praccount>-costcenter = <fs_excel>-imputacion."(23)
        <fs_praccountx>-costcenter = abap_true.
      ELSEIF <fs_excel>-knttp_ EQ 'P'.
        <fs_praccount>-wbs_element = <fs_excel>-imputacion.
        <fs_praccountx>-wbs_element = abap_true.
      ELSEIF <fs_excel>-knttp_ EQ 'F'.
        <fs_praccount>-orderid = <fs_excel>-imputacion.
        <fs_praccountx>-orderid = abap_true.
      ENDIF.


    ENDIF.
  ENDLOOP.

  DELETE gdt_pritemtext WHERE text_line EQ space.

  CALL FUNCTION 'BAPI_PR_CREATE'
    EXPORTING
      prheader     = gwa_prheader
      prheaderx    = gwa_prheaderx
    IMPORTING
      number       = gv_number
      prheaderexp  = gwa_prheaderexp
    TABLES
      return       = gdt_return
      pritem       = gdt_pritem
      pritemx      = gdt_pritemx
      praccount    = gdt_praccount
      praccountx   = gdt_praccountx
      pritemtext   = gdt_pritemtext
      prheadertext = gdt_prheadertext.
  READ TABLE gdt_return ASSIGNING FIELD-SYMBOL(<fs_return>) WITH KEY type = 'E'.
  IF sy-subrc EQ 0.
    LOOP AT gdt_excel ASSIGNING <fs_excel> WHERE tipo EQ 'P'.
      <fs_excel>-icon = '@0A@'.
      <fs_excel>-log_proces = <fs_excel>-log_proces && |,| && <fs_return>-message.
    ENDLOOP.
    go_alv->refresh( ).
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        wait = 'X'.
    LOOP AT gdt_excel ASSIGNING <fs_excel> WHERE tipo EQ 'P'.
      <fs_excel>-icon = '@08@'.
      <fs_excel>-log_proces = gv_number.
    ENDLOOP.
    go_alv->refresh( ).
  ENDIF.
ENDFORM.

